#: src/rdfeed:79 src/rdfeed:103
#, sh-printf-format
msgid "Could not write to %s."
msgstr "No se pudo escribir en %s."

#: src/rdfeed:82
#, sh-printf-format
msgid "Signing in to %s…"
msgstr "Iniciando sesión en %s…"

#: src/rdfeed:100
msgid ""
"The password could not be saved in the keyring, so each app asks for it."
msgstr ""
"No se pudo guardar la contraseña en el llavero, así que cada app la pedirá."

#: src/rdfeed:111
#, sh-printf-format
msgid "1 app from %s is now in your app menu."
msgstr "1 app de %s ya está en tu menú de aplicaciones."

#: src/rdfeed:113
#, sh-printf-format
msgid "%d apps from %s are now in your app menu."
msgstr "%d apps de %s ya están en tu menú de aplicaciones."

#: src/rdfeed:129
msgid ""
"Your IT department has the address. A work e-mail address often works too."
msgstr ""
"Tu departamento de TI tiene la dirección. A menudo también sirve tu correo "
"del trabajo."

#: src/rdfeed:130
msgid "Feed address, server or e-mail:"
msgstr "Dirección del feed, servidor o correo:"

#: src/rdfeed:137
#, sh-printf-format
msgid "No feed is registered for %s. Ask your IT department for the address."
msgstr ""
"No hay ningún feed registrado para %s. Pide la dirección a tu departamento "
"de TI."

#: src/rdfeed:142 src/rdfeed:156
msgid "User name (DOMAIN\\name or name@domain):"
msgstr "Nombre de usuario (DOMINIO\\nombre o nombre@dominio):"

#: src/rdfeed:146 src/rdfeed:159
msgid "Password:"
msgstr "Contraseña:"

#: src/rdfeed:178 src/rdfeed:236
#, sh-printf-format
msgid "No workspace yet. Add one with `%s add`."
msgstr "Todavía no hay ningún espacio de trabajo. Añade uno con `%s add`."

#: src/rdfeed:187 src/lib/launch.sh:220
#, sh-printf-format
msgid "No password saved for %s. Sign in again in rdfeed."
msgstr ""
"No hay ninguna contraseña guardada para %s. Vuelve a iniciar sesión en "
"rdfeed."

#: src/rdfeed:191 src/lib/launch.sh:149
#, sh-printf-format
msgid "Password for %s:"
msgstr "Contraseña de %s:"

#: src/rdfeed:195
#, sh-printf-format
msgid "Refreshing %s…"
msgstr "Actualizando %s…"

#: src/rdfeed:205
msgid "The password no longer works. Sign in again in rdfeed."
msgstr "La contraseña ya no funciona. Vuelve a iniciar sesión en rdfeed."

#: src/rdfeed:214
#, sh-printf-format
msgid "%s: %d apps"
msgstr "%s: %d apps"

#: src/rdfeed:222
#, sh-printf-format
msgid "Which workspace? See `%s list` for the names."
msgstr "¿Qué espacio de trabajo? Los nombres están en `%s list`."

#: src/rdfeed:229
#, sh-printf-format
msgid "%s and its apps are removed."
msgstr "%s y sus apps se han quitado."

#: src/rdfeed:253
#, sh-printf-format
msgid "Which app? See `%s list`."
msgstr "¿Qué app? Mira `%s list`."

#: src/rdfeed:268 src/lib/launch.sh:199
#, sh-printf-format
msgid "There is no app %s. See `%s list`."
msgstr "No existe la app %s. Mira `%s list`."

#: src/rdfeed:270
#, sh-printf-format
msgid "Several workspaces have %s. Write it as WORKSPACE/APP, see `%s list`."
msgstr ""
"Varios espacios de trabajo tienen %s. Escríbelo como ESPACIO/APP, mira `%s "
"list`."

#: src/rdfeed:278
msgid "Usage: rdfeed [command]"
msgstr "Uso: rdfeed [comando]"

#: src/rdfeed:280
msgid "Commands:"
msgstr "Comandos:"

#: src/rdfeed:281
msgid "Add the workspace of your company"
msgstr "Añadir el espacio de trabajo de tu empresa"

#: src/rdfeed:282
msgid "Load the apps again"
msgstr "Volver a cargar las apps"

#: src/rdfeed:283
msgid "List the workspaces and their apps"
msgstr "Listar los espacios de trabajo y sus apps"

#: src/rdfeed:284
msgid "Start an app, or open a file with it"
msgstr "Abrir una app, o un archivo con ella"

#: src/rdfeed:285
msgid "Remove a workspace and its apps"
msgstr "Quitar un espacio de trabajo y sus apps"

#: src/rdfeed:286
msgid "Show this help"
msgstr "Mostrar esta ayuda"

#: src/rdfeed:287
msgid "Show the version"
msgstr "Mostrar la versión"

#: src/rdfeed:289
msgid "Without a command an interactive menu is shown."
msgstr "Sin comando se muestra un menú interactivo."

#: src/rdfeed:313
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Comando desconocido: %s"

#: src/lib/common.sh:174 src/lib/menu.sh:251
msgid "never"
msgstr "nunca"

#: src/lib/common.sh:184
msgid "just now"
msgstr "ahora mismo"

#: src/lib/common.sh:186
msgid "1 minute ago"
msgstr "hace 1 minuto"

#: src/lib/common.sh:189
#, sh-printf-format
msgid "%d minutes ago"
msgstr "hace %d minutos"

#: src/lib/common.sh:191
msgid "1 hour ago"
msgstr "hace 1 hora"

#: src/lib/common.sh:194
#, sh-printf-format
msgid "%d hours ago"
msgstr "hace %d horas"

#: src/lib/common.sh:196
msgid "1 day ago"
msgstr "hace 1 día"

#: src/lib/common.sh:199
#, sh-printf-format
msgid "%d days ago"
msgstr "hace %d días"

#: src/lib/launch.sh:169
msgid ""
"Your password has expired. Change it on Windows or on the RD Web page, then "
"sign in again in rdfeed."
msgstr ""
"Tu contraseña ha caducado. Cámbiala en Windows o en la página de RD Web y "
"luego vuelve a iniciar sesión en rdfeed."

#: src/lib/launch.sh:171
msgid "Your account is locked. Ask your IT department."
msgstr "Tu cuenta está bloqueada. Pregunta a tu departamento de TI."

#: src/lib/launch.sh:173
msgid "The server did not accept the password. Sign in again in rdfeed."
msgstr ""
"El servidor no aceptó la contraseña. Vuelve a iniciar sesión en rdfeed."

#: src/lib/launch.sh:175
msgid "Could not reach the server. Check the internet connection."
msgstr "No se pudo conectar con el servidor. Comprueba la conexión a internet."

#: src/lib/launch.sh:178
#, sh-printf-format
msgid "FreeRDP stopped: %s"
msgstr "FreeRDP se detuvo: %s"

#: src/lib/launch.sh:205 src/lib/launch.sh:206
#, sh-printf-format
msgid "File not found: %s"
msgstr "No se encontró el archivo: %s"

#: src/lib/launch.sh:212 src/lib/launch.sh:213
msgid ""
"FreeRDP 3 is missing. Install it to start the apps (the package is called "
"freerdp)."
msgstr ""
"Falta FreeRDP 3. Instálalo para abrir las apps (el paquete se llama freerdp)."

#: src/lib/launch.sh:277
#, sh-printf-format
msgid "Opening %s in %s"
msgstr "Abriendo %s en %s"

#: src/lib/launch.sh:278
#, sh-printf-format
msgid "If it does not open by itself, open it in the app from the drive %s."
msgstr "Si no se abre solo, ábrelo en la app desde la unidad %s."

#: src/lib/launch.sh:280
#, sh-printf-format
msgid "Starting %s"
msgstr "Abriendo %s"

#: src/lib/launch.sh:281
msgid ""
"If your company uses MFA, confirm the sign-in in your authenticator app."
msgstr ""
"Si tu empresa usa MFA, confirma el inicio de sesión en tu app de "
"autenticación."

#: src/lib/launch.sh:290
msgid "A second sign-in is coming"
msgstr "Viene un segundo inicio de sesión"

#: src/lib/launch.sh:291
#, sh-printf-format
msgid ""
"Confirm the second prompt in your authenticator app too. It comes in about "
"%d seconds."
msgstr ""
"Confirma también la segunda solicitud en tu app de autenticación. Llega en "
"unos %d segundos."

#: src/lib/launch.sh:301
#, sh-printf-format
msgid "%s could not start"
msgstr "%s no se pudo abrir"

#: src/lib/launch.sh:303
#, sh-printf-format
msgid "Log: %s"
msgstr "Registro: %s"

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:93
msgid "[y/N]"
msgstr "[s/N]"

#: src/lib/menu.sh:163
msgid "1 app"
msgstr "1 app"

#: src/lib/menu.sh:165
#, sh-printf-format
msgid "%d apps"
msgstr "%d apps"

#: src/lib/menu.sh:190
msgid "No workspace yet. Add the one of your company with [1]."
msgstr ""
"Todavía no hay ningún espacio de trabajo. Añade el de tu empresa con [1]."

#: src/lib/menu.sh:233
msgid "off"
msgstr "desactivado"

#: src/lib/menu.sh:234
msgid "home folder"
msgstr "carpeta personal"

#: src/lib/menu.sh:237
msgid "Documents"
msgstr "Documentos"

#: src/lib/menu.sh:238
msgid "Downloads"
msgstr "Descargas"

#: src/lib/menu.sh:243
msgid "not found"
msgstr "no encontrada"

#: src/lib/menu.sh:246
#, sh-printf-format
msgid "automatic (%d %%)"
msgstr "automático (%d %%)"

#: src/lib/menu.sh:248
msgid "classic"
msgstr "clásico"

#: src/lib/menu.sh:249
msgid "GFX"
msgstr "GFX"

#: src/lib/menu.sh:250
msgid "always"
msgstr "siempre"

#: src/lib/menu.sh:252
msgid "automatic"
msgstr "automático"

#: src/lib/menu.sh:261
msgid ""
"The apps only see the files on the server. Pick a folder to open and save "
"files of this computer in them."
msgstr ""
"Las apps solo ven los archivos del servidor. Elige una carpeta para que "
"puedan abrir y guardar archivos de este equipo."

#: src/lib/menu.sh:262
msgid ""
"The apps can open and save files in this folder. It shows up as a drive in "
"them."
msgstr ""
"Las apps pueden abrir y guardar archivos en esta carpeta. Aparece en ellas "
"como una unidad."

#: src/lib/menu.sh:263
msgid ""
"Offers the apps under \"Open with\" for their file types, for example Word "
"for .docx. The folder of the file is shared with the app while it is open."
msgstr ""
"Ofrece las apps en «Abrir con» para sus tipos de archivo, por ejemplo Word "
"para .docx. La carpeta del archivo se comparte mientras está abierto."

#: src/lib/menu.sh:264
msgid ""
"How big the apps are drawn. Automatic follows the scale of your desktop, so "
"they are sharp and the right size."
msgstr ""
"Qué tamaño tienen las apps. Automático sigue la escala de tu escritorio, así "
"se ven nítidas y del tamaño correcto."

#: src/lib/menu.sh:265
msgid "Plays the sound of the apps here, for calls and videos."
msgstr "Reproduce aquí el sonido de las apps, para llamadas y vídeos."

#: src/lib/menu.sh:266
msgid ""
"Paints every window right. But some servers end the session right after "
"signing in, then go back to GFX."
msgstr "Dibuja bien cada ventana. Pero algunos servidores cierran la sesión justo después de entrar; entonces vuelve a GFX."

#: src/lib/menu.sh:267
msgid ""
"Works with every server. FreeRDP may not repaint a window after it was "
"minimized or resized."
msgstr "Funciona con cualquier servidor. Puede que FreeRDP no vuelva a dibujar una ventana tras minimizarla o cambiar su tamaño."

#: src/lib/menu.sh:268
msgid ""
"Always waits before the second sign-in. For when the second prompt does not "
"come with automatic."
msgstr ""
"Espera siempre antes del segundo inicio de sesión. Para cuando con "
"automático no llega la segunda solicitud."

#: src/lib/menu.sh:269
msgid "Never waits. Right when your company has no MFA."
msgstr "Nunca espera. Lo adecuado si tu empresa no usa MFA."

#: src/lib/menu.sh:270
msgid ""
"Many servers with MFA need a second sign-in, and its prompt only comes after "
"a short wait. Automatic waits when the first sign-in took a while."
msgstr ""
"Muchos servidores con MFA piden un segundo inicio de sesión, y su solicitud "
"solo llega tras una breve espera. Automático espera si el primero tardó un "
"poco."

#: src/lib/menu.sh:273
msgid ""
"Loads the list of apps again once a day, so new apps show up by themselves."
msgstr ""
"Vuelve a cargar la lista de apps una vez al día, así las nuevas aparecen "
"solas."

#: src/lib/menu.sh:275 src/lib/menu.sh:330
msgid "Needs a systemd user session."
msgstr "Necesita una sesión de usuario de systemd."

#: src/lib/menu.sh:322 src/lib/menu.sh:325
msgid "Could not save the setting."
msgstr "No se pudo guardar el ajuste."

#: src/lib/menu.sh:371 src/lib/menu.sh:609
msgid "Settings"
msgstr "Ajustes"

#: src/lib/menu.sh:372
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ elegir   ←→ o Espacio: cambiar   q: volver"

#: src/lib/menu.sh:373
msgid "ON"
msgstr "ACTIVADO"

#: src/lib/menu.sh:374
msgid "OFF"
msgstr "DESACTIVADO"

#: src/lib/menu.sh:456 src/lib/menu.sh:608
msgid "Workspaces"
msgstr "Espacios de trabajo"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:458
msgid ""
"↑↓ select   r: refresh   s: sign in again   d: remove   a: add   q: back"
msgstr ""
"↑↓ elegir   r: actualizar   s: volver a entrar   d: quitar   a: añadir   q: "
"volver"

#: src/lib/menu.sh:459
msgid "No workspace yet. Press a to add one."
msgstr "Todavía no hay ningún espacio de trabajo. Pulsa a para añadir uno."

#: src/lib/menu.sh:484
#, sh-printf-format
msgid "refreshed %s"
msgstr "actualizado %s"

#: src/lib/menu.sh:512
#, sh-printf-format
msgid "Remove \"%s\" and its apps?"
msgstr "¿Quitar «%s» y sus apps?"

#: src/lib/menu.sh:536 src/lib/menu.sh:607
msgid "Start an app"
msgstr "Abrir una app"

#: src/lib/menu.sh:537
msgid "↑↓ select   Enter: start   q: back"
msgstr "↑↓ elegir   Intro: abrir   q: volver"

#: src/lib/menu.sh:538
msgid "No apps yet. Add a workspace first."
msgstr "Todavía no hay apps. Añade primero un espacio de trabajo."

#: src/lib/menu.sh:579
#, sh-printf-format
msgid "%s is starting. It opens in a window of its own."
msgstr "%s se está abriendo. Se abre en una ventana propia."

#: src/lib/menu.sh:606
msgid "Add a workspace"
msgstr "Añadir un espacio de trabajo"

#: src/lib/menu.sh:610
msgid "Quit"
msgstr "Salir"

#: src/lib/workspace.sh:163
msgid "The server did not accept the user name or password."
msgstr "El servidor no aceptó el nombre de usuario o la contraseña."

#: src/lib/workspace.sh:164
#, sh-printf-format
msgid "Could not reach the server: %s"
msgstr "No se pudo conectar con el servidor: %s"

#: src/lib/workspace.sh:165
#, sh-printf-format
msgid "There is no RD Web feed at %s."
msgstr "No hay ningún feed de RD Web en %s."

#: src/lib/workspace.sh:166
#, sh-printf-format
msgid "Could not load the apps: %s"
msgstr "No se pudieron cargar las apps: %s"

#: src/lib/workspace.sh:282
#, sh-printf-format
msgid "Remote desktop of %s"
msgstr "Escritorio remoto de %s"

#: src/lib/workspace.sh:284
#, sh-printf-format
msgid "%s from %s"
msgstr "%s de %s"

#: src/lib/menu.sh
msgid "Apps"
msgstr "Apps"

#: src/lib/menu.sh
msgid "Share a folder"
msgstr "Compartir una carpeta"

#: src/lib/menu.sh
msgid "Open files with the apps"
msgstr "Abrir archivos con las apps"

#: src/lib/menu.sh
msgid "Size"
msgstr "Tamaño"

#: src/lib/menu.sh
msgid "Sound"
msgstr "Sonido"

#: src/lib/menu.sh
msgid "Graphics"
msgstr "Gráficos"

#: src/lib/menu.sh
msgid "Signing in"
msgstr "Inicio de sesión"

#: src/lib/menu.sh
msgid "Wait for the second MFA prompt"
msgstr "Esperar la segunda solicitud de MFA"

#: src/lib/menu.sh
msgid "Refresh the apps every day"
msgstr "Actualizar las apps cada día"
