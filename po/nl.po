#: src/rdfeed:79 src/rdfeed:103
#, sh-printf-format
msgid "Could not write to %s."
msgstr "Kon niet schrijven naar %s."

#: src/rdfeed:82
#, sh-printf-format
msgid "Signing in to %s…"
msgstr "Aanmelden bij %s…"

#: src/rdfeed:100
msgid ""
"The password could not be saved in the keyring, so each app asks for it."
msgstr ""
"Het wachtwoord kon niet in de sleutelbos worden opgeslagen, dus elke app "
"vraagt erom."

#: src/rdfeed:111
#, sh-printf-format
msgid "1 app from %s is now in your app menu."
msgstr "1 app van %s staat nu in je app-menu."

#: src/rdfeed:113
#, sh-printf-format
msgid "%d apps from %s are now in your app menu."
msgstr "%d apps van %s staan nu in je app-menu."

#: src/rdfeed:129
msgid ""
"Your IT department has the address. A work e-mail address often works too."
msgstr "Je IT-afdeling heeft het adres. Vaak werkt je werk-e-mailadres ook."

#: src/rdfeed:130
msgid "Feed address, server or e-mail:"
msgstr "Feedadres, server of e-mail:"

#: src/rdfeed:137
#, sh-printf-format
msgid "No feed is registered for %s. Ask your IT department for the address."
msgstr ""
"Er is geen feed geregistreerd voor %s. Vraag je IT-afdeling om het adres."

#: src/rdfeed:142 src/rdfeed:156
msgid "User name (DOMAIN\\name or name@domain):"
msgstr "Gebruikersnaam (DOMEIN\\naam of naam@domein):"

#: src/rdfeed:146 src/rdfeed:159
msgid "Password:"
msgstr "Wachtwoord:"

#: src/rdfeed:178 src/rdfeed:236
#, sh-printf-format
msgid "No workspace yet. Add one with `%s add`."
msgstr "Nog geen werkruimte. Voeg er een toe met `%s add`."

#: src/rdfeed:187 src/lib/launch.sh:220
#, sh-printf-format
msgid "No password saved for %s. Sign in again in rdfeed."
msgstr "Geen wachtwoord opgeslagen voor %s. Meld je opnieuw aan in rdfeed."

#: src/rdfeed:191 src/lib/launch.sh:149
#, sh-printf-format
msgid "Password for %s:"
msgstr "Wachtwoord voor %s:"

#: src/rdfeed:195
#, sh-printf-format
msgid "Refreshing %s…"
msgstr "%s vernieuwen…"

#: src/rdfeed:205
msgid "The password no longer works. Sign in again in rdfeed."
msgstr "Het wachtwoord werkt niet meer. Meld je opnieuw aan in rdfeed."

#: src/rdfeed:214
#, sh-printf-format
msgid "%s: %d apps"
msgstr "%s: %d apps"

#: src/rdfeed:222
#, sh-printf-format
msgid "Which workspace? See `%s list` for the names."
msgstr "Welke werkruimte? De namen staan in `%s list`."

#: src/rdfeed:229
#, sh-printf-format
msgid "%s and its apps are removed."
msgstr "%s en de apps ervan zijn verwijderd."

#: src/rdfeed:253
#, sh-printf-format
msgid "Which app? See `%s list`."
msgstr "Welke app? Zie `%s list`."

#: src/rdfeed:268 src/lib/launch.sh:199
#, sh-printf-format
msgid "There is no app %s. See `%s list`."
msgstr "Er is geen app %s. Zie `%s list`."

#: src/rdfeed:270
#, sh-printf-format
msgid "Several workspaces have %s. Write it as WORKSPACE/APP, see `%s list`."
msgstr ""
"Meerdere werkruimtes hebben %s. Schrijf het als WERKRUIMTE/APP, zie `%s "
"list`."

#: src/rdfeed:278
msgid "Usage: rdfeed [command]"
msgstr "Gebruik: rdfeed [opdracht]"

#: src/rdfeed:280
msgid "Commands:"
msgstr "Opdrachten:"

#: src/rdfeed:281
msgid "Add the workspace of your company"
msgstr "De werkruimte van je bedrijf toevoegen"

#: src/rdfeed:282
msgid "Load the apps again"
msgstr "De apps opnieuw laden"

#: src/rdfeed:283
msgid "List the workspaces and their apps"
msgstr "Werkruimtes en hun apps tonen"

#: src/rdfeed:284
msgid "Start an app, or open a file with it"
msgstr "Een app starten, of er een bestand mee openen"

#: src/rdfeed:285
msgid "Remove a workspace and its apps"
msgstr "Een werkruimte en de apps ervan verwijderen"

#: src/rdfeed:286
msgid "Show this help"
msgstr "Deze hulp tonen"

#: src/rdfeed:287
msgid "Show the version"
msgstr "De versie tonen"

#: src/rdfeed:289
msgid "Without a command an interactive menu is shown."
msgstr "Zonder opdracht verschijnt een interactief menu."

#: src/rdfeed:313
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Onbekende opdracht: %s"

#: src/lib/common.sh:174 src/lib/menu.sh:251
msgid "never"
msgstr "nooit"

#: src/lib/common.sh:184
msgid "just now"
msgstr "zojuist"

#: src/lib/common.sh:186
msgid "1 minute ago"
msgstr "1 minuut geleden"

#: src/lib/common.sh:189
#, sh-printf-format
msgid "%d minutes ago"
msgstr "%d minuten geleden"

#: src/lib/common.sh:191
msgid "1 hour ago"
msgstr "1 uur geleden"

#: src/lib/common.sh:194
#, sh-printf-format
msgid "%d hours ago"
msgstr "%d uur geleden"

#: src/lib/common.sh:196
msgid "1 day ago"
msgstr "1 dag geleden"

#: src/lib/common.sh:199
#, sh-printf-format
msgid "%d days ago"
msgstr "%d dagen geleden"

#: src/lib/launch.sh:169
msgid ""
"Your password has expired. Change it on Windows or on the RD Web page, then "
"sign in again in rdfeed."
msgstr ""
"Je wachtwoord is verlopen. Wijzig het in Windows of op de RD Web-pagina en "
"meld je daarna opnieuw aan in rdfeed."

#: src/lib/launch.sh:171
msgid "Your account is locked. Ask your IT department."
msgstr "Je account is geblokkeerd. Vraag het je IT-afdeling."

#: src/lib/launch.sh:173
msgid "The server did not accept the password. Sign in again in rdfeed."
msgstr ""
"De server heeft het wachtwoord niet geaccepteerd. Meld je opnieuw aan in "
"rdfeed."

#: src/lib/launch.sh:175
msgid "Could not reach the server. Check the internet connection."
msgstr "Kon de server niet bereiken. Controleer de internetverbinding."

#: src/lib/launch.sh:178
#, sh-printf-format
msgid "FreeRDP stopped: %s"
msgstr "FreeRDP is gestopt: %s"

#: src/lib/launch.sh:205 src/lib/launch.sh:206
#, sh-printf-format
msgid "File not found: %s"
msgstr "Bestand niet gevonden: %s"

#: src/lib/launch.sh:212 src/lib/launch.sh:213
msgid ""
"FreeRDP 3 is missing. Install it to start the apps (the package is called "
"freerdp)."
msgstr ""
"FreeRDP 3 ontbreekt. Installeer het om de apps te starten (het pakket heet "
"freerdp)."

#: src/lib/launch.sh:277
#, sh-printf-format
msgid "Opening %s in %s"
msgstr "%s wordt geopend in %s"

#: src/lib/launch.sh:278
#, sh-printf-format
msgid "If it does not open by itself, open it in the app from the drive %s."
msgstr ""
"Gaat het niet vanzelf open, open het dan in de app vanaf het station %s."

#: src/lib/launch.sh:280
#, sh-printf-format
msgid "Starting %s"
msgstr "%s wordt gestart"

#: src/lib/launch.sh:281
msgid ""
"If your company uses MFA, confirm the sign-in in your authenticator app."
msgstr ""
"Gebruikt je bedrijf MFA, bevestig de aanmelding dan in je authenticator-app."

#: src/lib/launch.sh:290
msgid "A second sign-in is coming"
msgstr "Er komt een tweede aanmelding"

#: src/lib/launch.sh:291
#, sh-printf-format
msgid ""
"Confirm the second prompt in your authenticator app too. It comes in about "
"%d seconds."
msgstr ""
"Bevestig ook het tweede verzoek in je authenticator-app. Het komt over "
"ongeveer %d seconden."

#: src/lib/launch.sh:301
#, sh-printf-format
msgid "%s could not start"
msgstr "%s kon niet starten"

#: src/lib/launch.sh:303
#, sh-printf-format
msgid "Log: %s"
msgstr "Logboek: %s"

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:93
msgid "[y/N]"
msgstr "[j/N]"

#: src/lib/menu.sh:163
msgid "1 app"
msgstr "1 app"

#: src/lib/menu.sh:165
#, sh-printf-format
msgid "%d apps"
msgstr "%d apps"

#: src/lib/menu.sh:190
msgid "No workspace yet. Add the one of your company with [1]."
msgstr "Nog geen werkruimte. Voeg die van je bedrijf toe met [1]."

#: src/lib/menu.sh:233
msgid "off"
msgstr "uit"

#: src/lib/menu.sh:234
msgid "home folder"
msgstr "thuismap"

#: src/lib/menu.sh:237
msgid "Documents"
msgstr "Documenten"

#: src/lib/menu.sh:238
msgid "Downloads"
msgstr "Downloads"

#: src/lib/menu.sh:243
msgid "not found"
msgstr "niet gevonden"

#: src/lib/menu.sh:246
#, sh-printf-format
msgid "automatic (%d %%)"
msgstr "automatisch (%d %%)"

#: src/lib/menu.sh:248
msgid "classic"
msgstr "klassiek"

#: src/lib/menu.sh:249
msgid "GFX"
msgstr "GFX"

#: src/lib/menu.sh:250
msgid "always"
msgstr "altijd"

#: src/lib/menu.sh:252
msgid "automatic"
msgstr "automatisch"

#: src/lib/menu.sh:261
msgid ""
"The apps only see the files on the server. Pick a folder to open and save "
"files of this computer in them."
msgstr ""
"De apps zien alleen de bestanden op de server. Kies een map, dan kunnen ze "
"bestanden van deze computer openen en opslaan."

#: src/lib/menu.sh:262
msgid ""
"The apps can open and save files in this folder. It shows up as a drive in "
"them."
msgstr ""
"De apps kunnen in deze map bestanden openen en opslaan. Hij verschijnt "
"daarin als station."

#: src/lib/menu.sh:263
msgid ""
"Offers the apps under \"Open with\" for their file types, for example Word "
"for .docx. The folder of the file is shared with the app while it is open."
msgstr ""
"Biedt de apps aan onder \"Openen met\" voor hun bestandstypen, bijvoorbeeld "
"Word voor .docx. De map van het bestand wordt gedeeld zolang het open is."

#: src/lib/menu.sh:264
msgid ""
"How big the apps are drawn. Automatic follows the scale of your desktop, so "
"they are sharp and the right size."
msgstr ""
"Hoe groot de apps worden getekend. Automatisch volgt de schaal van je "
"bureaublad, zo zijn ze scherp en goed van formaat."

#: src/lib/menu.sh:265
msgid "Plays the sound of the apps here, for calls and videos."
msgstr "Speelt het geluid van de apps hier af, voor gesprekken en video's."

#: src/lib/menu.sh:266
msgid ""
"Paints every window right. But some servers end the session right after "
"signing in, then go back to GFX."
msgstr "Tekent elk venster goed. Maar sommige servers beëindigen de sessie direct na het aanmelden; ga dan terug naar GFX."

#: src/lib/menu.sh:267
msgid ""
"Works with every server. FreeRDP may not repaint a window after it was "
"minimized or resized."
msgstr "Werkt met elke server. FreeRDP tekent een venster na minimaliseren of van formaat wijzigen misschien niet opnieuw."

#: src/lib/menu.sh:268
msgid ""
"Always waits before the second sign-in. For when the second prompt does not "
"come with automatic."
msgstr ""
"Wacht altijd voor de tweede aanmelding. Voor als het tweede verzoek met "
"automatisch niet komt."

#: src/lib/menu.sh:269
msgid "Never waits. Right when your company has no MFA."
msgstr "Wacht nooit. Goed als je bedrijf geen MFA gebruikt."

#: src/lib/menu.sh:270
msgid ""
"Many servers with MFA need a second sign-in, and its prompt only comes after "
"a short wait. Automatic waits when the first sign-in took a while."
msgstr ""
"Veel servers met MFA vragen een tweede aanmelding, en het verzoek daarvoor "
"komt pas na even wachten. Automatisch wacht als de eerste aanmelding even "
"duurde."

#: src/lib/menu.sh:273
msgid ""
"Loads the list of apps again once a day, so new apps show up by themselves."
msgstr ""
"Laadt de lijst met apps één keer per dag opnieuw, zo verschijnen nieuwe apps "
"vanzelf."

#: src/lib/menu.sh:275 src/lib/menu.sh:330
msgid "Needs a systemd user session."
msgstr "Vereist een systemd-gebruikerssessie."

#: src/lib/menu.sh:322 src/lib/menu.sh:325
msgid "Could not save the setting."
msgstr "Kon de instelling niet opslaan."

#: src/lib/menu.sh:371 src/lib/menu.sh:609
msgid "Settings"
msgstr "Instellingen"

#: src/lib/menu.sh:372
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ kiezen   ←→ of Spatie: wijzigen   q: terug"

#: src/lib/menu.sh:373
msgid "ON"
msgstr "AAN"

#: src/lib/menu.sh:374
msgid "OFF"
msgstr "UIT"

#: src/lib/menu.sh:456 src/lib/menu.sh:608
msgid "Workspaces"
msgstr "Werkruimtes"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:458
msgid ""
"↑↓ select   r: refresh   s: sign in again   d: remove   a: add   q: back"
msgstr ""
"↑↓ kiezen   r: vernieuwen   s: opnieuw aanmelden   d: verwijderen   a: "
"toevoegen   q: terug"

#: src/lib/menu.sh:459
msgid "No workspace yet. Press a to add one."
msgstr "Nog geen werkruimte. Druk op a om er een toe te voegen."

#: src/lib/menu.sh:484
#, sh-printf-format
msgid "refreshed %s"
msgstr "vernieuwd %s"

#: src/lib/menu.sh:512
#, sh-printf-format
msgid "Remove \"%s\" and its apps?"
msgstr "\"%s\" en de apps ervan verwijderen?"

#: src/lib/menu.sh:536 src/lib/menu.sh:607
msgid "Start an app"
msgstr "Een app starten"

#: src/lib/menu.sh:537
msgid "↑↓ select   Enter: start   q: back"
msgstr "↑↓ kiezen   Enter: starten   q: terug"

#: src/lib/menu.sh:538
msgid "No apps yet. Add a workspace first."
msgstr "Nog geen apps. Voeg eerst een werkruimte toe."

#: src/lib/menu.sh:579
#, sh-printf-format
msgid "%s is starting. It opens in a window of its own."
msgstr "%s wordt gestart. Het opent in een eigen venster."

#: src/lib/menu.sh:606
msgid "Add a workspace"
msgstr "Werkruimte toevoegen"

#: src/lib/menu.sh:610
msgid "Quit"
msgstr "Afsluiten"

#: src/lib/workspace.sh:163
msgid "The server did not accept the user name or password."
msgstr "De server heeft de gebruikersnaam of het wachtwoord niet geaccepteerd."

#: src/lib/workspace.sh:164
#, sh-printf-format
msgid "Could not reach the server: %s"
msgstr "Kon de server niet bereiken: %s"

#: src/lib/workspace.sh:165
#, sh-printf-format
msgid "There is no RD Web feed at %s."
msgstr "Er is geen RD Web-feed op %s."

#: src/lib/workspace.sh:166
#, sh-printf-format
msgid "Could not load the apps: %s"
msgstr "Kon de apps niet laden: %s"

#: src/lib/workspace.sh:282
#, sh-printf-format
msgid "Remote desktop of %s"
msgstr "Extern bureaublad van %s"

#: src/lib/workspace.sh:284
#, sh-printf-format
msgid "%s from %s"
msgstr "%s van %s"

#: src/lib/menu.sh
msgid "Apps"
msgstr "Apps"

#: src/lib/menu.sh
msgid "Share a folder"
msgstr "Map delen"

#: src/lib/menu.sh
msgid "Open files with the apps"
msgstr "Bestanden openen met de apps"

#: src/lib/menu.sh
msgid "Size"
msgstr "Grootte"

#: src/lib/menu.sh
msgid "Sound"
msgstr "Geluid"

#: src/lib/menu.sh
msgid "Graphics"
msgstr "Weergave"

#: src/lib/menu.sh
msgid "Signing in"
msgstr "Aanmelden"

#: src/lib/menu.sh
msgid "Wait for the second MFA prompt"
msgstr "Wachten op tweede MFA-verzoek"

#: src/lib/menu.sh
msgid "Refresh the apps every day"
msgstr "Apps elke dag vernieuwen"
