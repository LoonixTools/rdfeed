#: src/rdfeed:79 src/rdfeed:103
#, sh-printf-format
msgid "Could not write to %s."
msgstr "Nie udało się zapisać w %s."

#: src/rdfeed:82
#, sh-printf-format
msgid "Signing in to %s…"
msgstr "Logowanie do %s…"

#: src/rdfeed:100
msgid ""
"The password could not be saved in the keyring, so each app asks for it."
msgstr ""
"Nie udało się zapisać hasła w pęku kluczy, więc każda aplikacja o nie zapyta."

#: src/rdfeed:111
#, sh-printf-format
msgid "1 app from %s is now in your app menu."
msgstr "1 aplikacja z %s jest teraz w menu aplikacji."

#: src/rdfeed:113
#, sh-printf-format
msgid "%d apps from %s are now in your app menu."
msgstr "Dodano aplikacje (%d) z %s do menu aplikacji."

#: src/rdfeed:129
msgid ""
"Your IT department has the address. A work e-mail address often works too."
msgstr "Adres ma twój dział IT. Często działa też służbowy adres e-mail."

#: src/rdfeed:130
msgid "Feed address, server or e-mail:"
msgstr "Adres kanału, serwer lub e-mail:"

#: src/rdfeed:137
#, sh-printf-format
msgid "No feed is registered for %s. Ask your IT department for the address."
msgstr "Dla %s nie zarejestrowano kanału. Zapytaj dział IT o adres."

#: src/rdfeed:142 src/rdfeed:156
msgid "User name (DOMAIN\\name or name@domain):"
msgstr "Nazwa użytkownika (DOMENA\\nazwa lub nazwa@domena):"

#: src/rdfeed:146 src/rdfeed:159
msgid "Password:"
msgstr "Hasło:"

#: src/rdfeed:178 src/rdfeed:236
#, sh-printf-format
msgid "No workspace yet. Add one with `%s add`."
msgstr "Nie ma jeszcze obszaru roboczego. Dodaj go poleceniem `%s add`."

#: src/rdfeed:187 src/lib/launch.sh:220
#, sh-printf-format
msgid "No password saved for %s. Sign in again in rdfeed."
msgstr "Brak zapisanego hasła dla %s. Zaloguj się ponownie w rdfeed."

#: src/rdfeed:191 src/lib/launch.sh:149
#, sh-printf-format
msgid "Password for %s:"
msgstr "Hasło dla %s:"

#: src/rdfeed:195
#, sh-printf-format
msgid "Refreshing %s…"
msgstr "Odświeżanie %s…"

#: src/rdfeed:205
msgid "The password no longer works. Sign in again in rdfeed."
msgstr "Hasło już nie działa. Zaloguj się ponownie w rdfeed."

#: src/rdfeed:214
#, sh-printf-format
msgid "%s: %d apps"
msgstr "%s: aplikacje: %d"

#: src/rdfeed:222
#, sh-printf-format
msgid "Which workspace? See `%s list` for the names."
msgstr "Który obszar roboczy? Nazwy pokazuje `%s list`."

#: src/rdfeed:229
#, sh-printf-format
msgid "%s and its apps are removed."
msgstr "Usunięto %s i jego aplikacje."

#: src/rdfeed:253
#, sh-printf-format
msgid "Which app? See `%s list`."
msgstr "Która aplikacja? Zobacz `%s list`."

#: src/rdfeed:268 src/lib/launch.sh:199
#, sh-printf-format
msgid "There is no app %s. See `%s list`."
msgstr "Nie ma aplikacji %s. Zobacz `%s list`."

#: src/rdfeed:270
#, sh-printf-format
msgid "Several workspaces have %s. Write it as WORKSPACE/APP, see `%s list`."
msgstr ""
"Kilka obszarów roboczych ma %s. Wpisz to jako OBSZAR/APLIKACJA, zobacz `%s "
"list`."

#: src/rdfeed:278
msgid "Usage: rdfeed [command]"
msgstr "Użycie: rdfeed [polecenie]"

#: src/rdfeed:280
msgid "Commands:"
msgstr "Polecenia:"

#: src/rdfeed:281
msgid "Add the workspace of your company"
msgstr "Dodaj obszar roboczy swojej firmy"

#: src/rdfeed:282
msgid "Load the apps again"
msgstr "Wczytaj aplikacje ponownie"

#: src/rdfeed:283
msgid "List the workspaces and their apps"
msgstr "Wyświetl obszary robocze i ich aplikacje"

#: src/rdfeed:284
msgid "Start an app, or open a file with it"
msgstr "Uruchom aplikację lub otwórz nią plik"

#: src/rdfeed:285
msgid "Remove a workspace and its apps"
msgstr "Usuń obszar roboczy i jego aplikacje"

#: src/rdfeed:286
msgid "Show this help"
msgstr "Pokaż tę pomoc"

#: src/rdfeed:287
msgid "Show the version"
msgstr "Pokaż wersję"

#: src/rdfeed:289
msgid "Without a command an interactive menu is shown."
msgstr "Bez polecenia wyświetla się interaktywne menu."

#: src/rdfeed:313
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Nieznane polecenie: %s"

#: src/lib/common.sh:174 src/lib/menu.sh:251
msgid "never"
msgstr "nigdy"

#: src/lib/common.sh:184
msgid "just now"
msgstr "przed chwilą"

#: src/lib/common.sh:186
msgid "1 minute ago"
msgstr "1 minutę temu"

#: src/lib/common.sh:189
#, sh-printf-format
msgid "%d minutes ago"
msgstr "%d min temu"

#: src/lib/common.sh:191
msgid "1 hour ago"
msgstr "1 godzinę temu"

#: src/lib/common.sh:194
#, sh-printf-format
msgid "%d hours ago"
msgstr "%d godz. temu"

#: src/lib/common.sh:196
msgid "1 day ago"
msgstr "1 dzień temu"

#: src/lib/common.sh:199
#, sh-printf-format
msgid "%d days ago"
msgstr "%d dni temu"

#: src/lib/launch.sh:169
msgid ""
"Your password has expired. Change it on Windows or on the RD Web page, then "
"sign in again in rdfeed."
msgstr ""
"Hasło wygasło. Zmień je w Windows lub na stronie RD Web, a potem zaloguj się "
"ponownie w rdfeed."

#: src/lib/launch.sh:171
msgid "Your account is locked. Ask your IT department."
msgstr "Konto jest zablokowane. Zapytaj dział IT."

#: src/lib/launch.sh:173
msgid "The server did not accept the password. Sign in again in rdfeed."
msgstr "Serwer nie przyjął hasła. Zaloguj się ponownie w rdfeed."

#: src/lib/launch.sh:175
msgid "Could not reach the server. Check the internet connection."
msgstr "Nie udało się połączyć z serwerem. Sprawdź połączenie z internetem."

#: src/lib/launch.sh:178
#, sh-printf-format
msgid "FreeRDP stopped: %s"
msgstr "FreeRDP zatrzymał się: %s"

#: src/lib/launch.sh:205 src/lib/launch.sh:206
#, sh-printf-format
msgid "File not found: %s"
msgstr "Nie znaleziono pliku: %s"

#: src/lib/launch.sh:212 src/lib/launch.sh:213
msgid ""
"FreeRDP 3 is missing. Install it to start the apps (the package is called "
"freerdp)."
msgstr ""
"Brakuje FreeRDP 3. Zainstaluj go, aby uruchamiać aplikacje (pakiet nazywa "
"się freerdp)."

#: src/lib/launch.sh:277
#, sh-printf-format
msgid "Opening %s in %s"
msgstr "Otwieranie %s w %s"

#: src/lib/launch.sh:278
#, sh-printf-format
msgid "If it does not open by itself, open it in the app from the drive %s."
msgstr "Jeśli nie otworzy się sam, otwórz go w aplikacji z dysku %s."

#: src/lib/launch.sh:280
#, sh-printf-format
msgid "Starting %s"
msgstr "Uruchamianie: %s"

#: src/lib/launch.sh:281
msgid ""
"If your company uses MFA, confirm the sign-in in your authenticator app."
msgstr ""
"Jeśli firma używa MFA, potwierdź logowanie w aplikacji uwierzytelniającej."

#: src/lib/launch.sh:290
msgid "A second sign-in is coming"
msgstr "Nadchodzi drugie logowanie"

#: src/lib/launch.sh:291
#, sh-printf-format
msgid ""
"Confirm the second prompt in your authenticator app too. It comes in about "
"%d seconds."
msgstr ""
"Potwierdź też drugie żądanie w aplikacji uwierzytelniającej. Przyjdzie za "
"około %d s."

#: src/lib/launch.sh:301
#, sh-printf-format
msgid "%s could not start"
msgstr "Nie udało się uruchomić: %s"

#: src/lib/launch.sh:303
#, sh-printf-format
msgid "Log: %s"
msgstr "Dziennik: %s"

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:93
msgid "[y/N]"
msgstr "[t/N]"

#: src/lib/menu.sh:163
msgid "1 app"
msgstr "1 aplikacja"

#: src/lib/menu.sh:165
#, sh-printf-format
msgid "%d apps"
msgstr "aplikacje: %d"

#: src/lib/menu.sh:190
msgid "No workspace yet. Add the one of your company with [1]."
msgstr "Nie ma jeszcze obszaru roboczego. Dodaj obszar swojej firmy przez [1]."

#: src/lib/menu.sh:233
msgid "off"
msgstr "wył."

#: src/lib/menu.sh:234
msgid "home folder"
msgstr "folder domowy"

#: src/lib/menu.sh:237
msgid "Documents"
msgstr "Dokumenty"

#: src/lib/menu.sh:238
msgid "Downloads"
msgstr "Pobrane"

#: src/lib/menu.sh:243
msgid "not found"
msgstr "nie znaleziono"

#: src/lib/menu.sh:246
#, sh-printf-format
msgid "automatic (%d %%)"
msgstr "automatyczny (%d %%)"

#: src/lib/menu.sh:248
msgid "classic"
msgstr "klasyczny"

#: src/lib/menu.sh:249
msgid "GFX"
msgstr "GFX"

#: src/lib/menu.sh:250
msgid "always"
msgstr "zawsze"

#: src/lib/menu.sh:252
msgid "automatic"
msgstr "automatycznie"

#: src/lib/menu.sh:261
msgid ""
"The apps only see the files on the server. Pick a folder to open and save "
"files of this computer in them."
msgstr ""
"Aplikacje widzą tylko pliki na serwerze. Wybierz folder, aby mogły otwierać "
"i zapisywać pliki z tego komputera."

#: src/lib/menu.sh:262
msgid ""
"The apps can open and save files in this folder. It shows up as a drive in "
"them."
msgstr ""
"Aplikacje mogą otwierać i zapisywać pliki w tym folderze. Widzą go jako dysk."

#: src/lib/menu.sh:263
msgid ""
"Offers the apps under \"Open with\" for their file types, for example Word "
"for .docx. The folder of the file is shared with the app while it is open."
msgstr ""
"Pokazuje aplikacje w „Otwórz za pomocą” dla ich typów plików, na przykład "
"Word dla .docx. Folder pliku jest udostępniany, dopóki plik jest otwarty."

#: src/lib/menu.sh:264
msgid ""
"How big the apps are drawn. Automatic follows the scale of your desktop, so "
"they are sharp and the right size."
msgstr ""
"Jak duże są rysowane aplikacje. Automatyczny podąża za skalą pulpitu, więc "
"są ostre i mają właściwy rozmiar."

#: src/lib/menu.sh:265
msgid "Plays the sound of the apps here, for calls and videos."
msgstr "Odtwarza tutaj dźwięk aplikacji, do rozmów i filmów."

#: src/lib/menu.sh:266
msgid ""
"Paints every window right. But some servers end the session right after "
"signing in, then go back to GFX."
msgstr "Rysuje każde okno poprawnie. Ale niektóre serwery kończą sesję zaraz po zalogowaniu, wtedy wróć do GFX."

#: src/lib/menu.sh:267
msgid ""
"Works with every server. FreeRDP may not repaint a window after it was "
"minimized or resized."
msgstr "Działa z każdym serwerem. FreeRDP może nie odrysować okna po zminimalizowaniu lub zmianie rozmiaru."

#: src/lib/menu.sh:268
msgid ""
"Always waits before the second sign-in. For when the second prompt does not "
"come with automatic."
msgstr ""
"Zawsze czeka przed drugim logowaniem. Gdy przy ustawieniu automatycznym "
"drugie żądanie nie przychodzi."

#: src/lib/menu.sh:269
msgid "Never waits. Right when your company has no MFA."
msgstr "Nigdy nie czeka. Właściwe, gdy firma nie używa MFA."

#: src/lib/menu.sh:270
msgid ""
"Many servers with MFA need a second sign-in, and its prompt only comes after "
"a short wait. Automatic waits when the first sign-in took a while."
msgstr ""
"Wiele serwerów z MFA wymaga drugiego logowania, a jego żądanie przychodzi "
"dopiero po chwili. Automatycznie czeka, gdy pierwsze logowanie trochę trwało."

#: src/lib/menu.sh:273
msgid ""
"Loads the list of apps again once a day, so new apps show up by themselves."
msgstr ""
"Wczytuje listę aplikacji raz dziennie, więc nowe aplikacje pojawiają się "
"same."

#: src/lib/menu.sh:275 src/lib/menu.sh:330
msgid "Needs a systemd user session."
msgstr "Wymaga sesji użytkownika systemd."

#: src/lib/menu.sh:322 src/lib/menu.sh:325
msgid "Could not save the setting."
msgstr "Nie udało się zapisać ustawienia."

#: src/lib/menu.sh:371 src/lib/menu.sh:609
msgid "Settings"
msgstr "Ustawienia"

#: src/lib/menu.sh:372
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ wybierz   ←→ lub Spacja: zmień   q: wstecz"

#: src/lib/menu.sh:373
msgid "ON"
msgstr "WŁ."

#: src/lib/menu.sh:374
msgid "OFF"
msgstr "WYŁ."

#: src/lib/menu.sh:456 src/lib/menu.sh:608
msgid "Workspaces"
msgstr "Obszary robocze"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:458
msgid ""
"↑↓ select   r: refresh   s: sign in again   d: remove   a: add   q: back"
msgstr ""
"↑↓ wybierz   r: odśwież   s: zaloguj ponownie   d: usuń   a: dodaj   q: "
"wstecz"

#: src/lib/menu.sh:459
msgid "No workspace yet. Press a to add one."
msgstr "Nie ma jeszcze obszaru roboczego. Naciśnij a, aby dodać."

#: src/lib/menu.sh:484
#, sh-printf-format
msgid "refreshed %s"
msgstr "odświeżono %s"

#: src/lib/menu.sh:512
#, sh-printf-format
msgid "Remove \"%s\" and its apps?"
msgstr "Usunąć „%s” i jego aplikacje?"

#: src/lib/menu.sh:536 src/lib/menu.sh:607
msgid "Start an app"
msgstr "Uruchom aplikację"

#: src/lib/menu.sh:537
msgid "↑↓ select   Enter: start   q: back"
msgstr "↑↓ wybierz   Enter: uruchom   q: wstecz"

#: src/lib/menu.sh:538
msgid "No apps yet. Add a workspace first."
msgstr "Nie ma jeszcze aplikacji. Najpierw dodaj obszar roboczy."

#: src/lib/menu.sh:579
#, sh-printf-format
msgid "%s is starting. It opens in a window of its own."
msgstr "Uruchamianie: %s. Otworzy się we własnym oknie."

#: src/lib/menu.sh:606
msgid "Add a workspace"
msgstr "Dodaj obszar roboczy"

#: src/lib/menu.sh:610
msgid "Quit"
msgstr "Zakończ"

#: src/lib/workspace.sh:163
msgid "The server did not accept the user name or password."
msgstr "Serwer nie przyjął nazwy użytkownika lub hasła."

#: src/lib/workspace.sh:164
#, sh-printf-format
msgid "Could not reach the server: %s"
msgstr "Nie udało się połączyć z serwerem: %s"

#: src/lib/workspace.sh:165
#, sh-printf-format
msgid "There is no RD Web feed at %s."
msgstr "Pod adresem %s nie ma kanału RD Web."

#: src/lib/workspace.sh:166
#, sh-printf-format
msgid "Could not load the apps: %s"
msgstr "Nie udało się wczytać aplikacji: %s"

#: src/lib/workspace.sh:282
#, sh-printf-format
msgid "Remote desktop of %s"
msgstr "Pulpit zdalny %s"

#: src/lib/workspace.sh:284
#, sh-printf-format
msgid "%s from %s"
msgstr "%s z %s"

#: src/lib/menu.sh
msgid "Apps"
msgstr "Aplikacje"

#: src/lib/menu.sh
msgid "Share a folder"
msgstr "Udostępnij folder"

#: src/lib/menu.sh
msgid "Open files with the apps"
msgstr "Otwieraj pliki w aplikacjach"

#: src/lib/menu.sh
msgid "Size"
msgstr "Rozmiar"

#: src/lib/menu.sh
msgid "Sound"
msgstr "Dźwięk"

#: src/lib/menu.sh
msgid "Graphics"
msgstr "Grafika"

#: src/lib/menu.sh
msgid "Signing in"
msgstr "Logowanie"

#: src/lib/menu.sh
msgid "Wait for the second MFA prompt"
msgstr "Czekaj na drugie żądanie MFA"

#: src/lib/menu.sh
msgid "Refresh the apps every day"
msgstr "Odświeżaj aplikacje codziennie"
