#: src/rdfeed:79 src/rdfeed:103
#, sh-printf-format
msgid "Could not write to %s."
msgstr "Impossibile scrivere in %s."

#: src/rdfeed:82
#, sh-printf-format
msgid "Signing in to %s…"
msgstr "Accesso a %s…"

#: src/rdfeed:100
msgid ""
"The password could not be saved in the keyring, so each app asks for it."
msgstr ""
"Non è stato possibile salvare la password nel portachiavi, quindi ogni app "
"la chiederà."

#: src/rdfeed:111
#, sh-printf-format
msgid "1 app from %s is now in your app menu."
msgstr "1 app di %s è ora nel menu delle applicazioni."

#: src/rdfeed:113
#, sh-printf-format
msgid "%d apps from %s are now in your app menu."
msgstr "%d app di %s sono ora nel menu delle applicazioni."

#: src/rdfeed:129
msgid ""
"Your IT department has the address. A work e-mail address often works too."
msgstr ""
"L'indirizzo lo ha il tuo reparto IT. Spesso funziona anche l'e-mail di "
"lavoro."

#: src/rdfeed:130
msgid "Feed address, server or e-mail:"
msgstr "Indirizzo del feed, server o e-mail:"

#: src/rdfeed:137
#, sh-printf-format
msgid "No feed is registered for %s. Ask your IT department for the address."
msgstr "Nessun feed registrato per %s. Chiedi l'indirizzo al tuo reparto IT."

#: src/rdfeed:142 src/rdfeed:156
msgid "User name (DOMAIN\\name or name@domain):"
msgstr "Nome utente (DOMINIO\\nome o nome@dominio):"

#: src/rdfeed:146 src/rdfeed:159
msgid "Password:"
msgstr "Password:"

#: src/rdfeed:178 src/rdfeed:236
#, sh-printf-format
msgid "No workspace yet. Add one with `%s add`."
msgstr "Nessuno spazio di lavoro ancora. Aggiungine uno con `%s add`."

#: src/rdfeed:187 src/lib/launch.sh:220
#, sh-printf-format
msgid "No password saved for %s. Sign in again in rdfeed."
msgstr "Nessuna password salvata per %s. Accedi di nuovo in rdfeed."

#: src/rdfeed:191 src/lib/launch.sh:149
#, sh-printf-format
msgid "Password for %s:"
msgstr "Password per %s:"

#: src/rdfeed:195
#, sh-printf-format
msgid "Refreshing %s…"
msgstr "Aggiornamento di %s…"

#: src/rdfeed:205
msgid "The password no longer works. Sign in again in rdfeed."
msgstr "La password non funziona più. Accedi di nuovo in rdfeed."

#: src/rdfeed:214
#, sh-printf-format
msgid "%s: %d apps"
msgstr "%s: %d app"

#: src/rdfeed:222
#, sh-printf-format
msgid "Which workspace? See `%s list` for the names."
msgstr "Quale spazio di lavoro? I nomi sono in `%s list`."

#: src/rdfeed:229
#, sh-printf-format
msgid "%s and its apps are removed."
msgstr "%s e le sue app sono stati rimossi."

#: src/rdfeed:253
#, sh-printf-format
msgid "Which app? See `%s list`."
msgstr "Quale app? Vedi `%s list`."

#: src/rdfeed:268 src/lib/launch.sh:199
#, sh-printf-format
msgid "There is no app %s. See `%s list`."
msgstr "Non esiste l'app %s. Vedi `%s list`."

#: src/rdfeed:270
#, sh-printf-format
msgid "Several workspaces have %s. Write it as WORKSPACE/APP, see `%s list`."
msgstr ""
"Più spazi di lavoro hanno %s. Scrivilo come SPAZIO/APP, vedi `%s list`."

#: src/rdfeed:278
msgid "Usage: rdfeed [command]"
msgstr "Uso: rdfeed [comando]"

#: src/rdfeed:280
msgid "Commands:"
msgstr "Comandi:"

#: src/rdfeed:281
msgid "Add the workspace of your company"
msgstr "Aggiungi lo spazio di lavoro della tua azienda"

#: src/rdfeed:282
msgid "Load the apps again"
msgstr "Ricarica le app"

#: src/rdfeed:283
msgid "List the workspaces and their apps"
msgstr "Elenca gli spazi di lavoro e le loro app"

#: src/rdfeed:284
msgid "Start an app, or open a file with it"
msgstr "Avvia un'app, o apri un file con essa"

#: src/rdfeed:285
msgid "Remove a workspace and its apps"
msgstr "Rimuovi uno spazio di lavoro e le sue app"

#: src/rdfeed:286
msgid "Show this help"
msgstr "Mostra questo aiuto"

#: src/rdfeed:287
msgid "Show the version"
msgstr "Mostra la versione"

#: src/rdfeed:289
msgid "Without a command an interactive menu is shown."
msgstr "Senza comando viene mostrato un menu interattivo."

#: src/rdfeed:313
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Comando sconosciuto: %s"

#: src/lib/common.sh:174 src/lib/menu.sh:251
msgid "never"
msgstr "mai"

#: src/lib/common.sh:184
msgid "just now"
msgstr "proprio ora"

#: src/lib/common.sh:186
msgid "1 minute ago"
msgstr "1 minuto fa"

#: src/lib/common.sh:189
#, sh-printf-format
msgid "%d minutes ago"
msgstr "%d minuti fa"

#: src/lib/common.sh:191
msgid "1 hour ago"
msgstr "1 ora fa"

#: src/lib/common.sh:194
#, sh-printf-format
msgid "%d hours ago"
msgstr "%d ore fa"

#: src/lib/common.sh:196
msgid "1 day ago"
msgstr "1 giorno fa"

#: src/lib/common.sh:199
#, sh-printf-format
msgid "%d days ago"
msgstr "%d giorni fa"

#: src/lib/launch.sh:169
msgid ""
"Your password has expired. Change it on Windows or on the RD Web page, then "
"sign in again in rdfeed."
msgstr ""
"La password è scaduta. Cambiala in Windows o sulla pagina RD Web, poi accedi "
"di nuovo in rdfeed."

#: src/lib/launch.sh:171
msgid "Your account is locked. Ask your IT department."
msgstr "Il tuo account è bloccato. Chiedi al reparto IT."

#: src/lib/launch.sh:173
msgid "The server did not accept the password. Sign in again in rdfeed."
msgstr "Il server non ha accettato la password. Accedi di nuovo in rdfeed."

#: src/lib/launch.sh:175
msgid "Could not reach the server. Check the internet connection."
msgstr ""
"Impossibile raggiungere il server. Controlla la connessione a internet."

#: src/lib/launch.sh:178
#, sh-printf-format
msgid "FreeRDP stopped: %s"
msgstr "FreeRDP si è fermato: %s"

#: src/lib/launch.sh:205 src/lib/launch.sh:206
#, sh-printf-format
msgid "File not found: %s"
msgstr "File non trovato: %s"

#: src/lib/launch.sh:212 src/lib/launch.sh:213
msgid ""
"FreeRDP 3 is missing. Install it to start the apps (the package is called "
"freerdp)."
msgstr ""
"Manca FreeRDP 3. Installalo per avviare le app (il pacchetto si chiama "
"freerdp)."

#: src/lib/launch.sh:277
#, sh-printf-format
msgid "Opening %s in %s"
msgstr "Apertura di %s in %s"

#: src/lib/launch.sh:278
#, sh-printf-format
msgid "If it does not open by itself, open it in the app from the drive %s."
msgstr "Se non si apre da solo, aprilo nell'app dall'unità %s."

#: src/lib/launch.sh:280
#, sh-printf-format
msgid "Starting %s"
msgstr "Avvio di %s"

#: src/lib/launch.sh:281
msgid ""
"If your company uses MFA, confirm the sign-in in your authenticator app."
msgstr ""
"Se la tua azienda usa l'MFA, conferma l'accesso nell'app di autenticazione."

#: src/lib/launch.sh:290
msgid "A second sign-in is coming"
msgstr "Sta arrivando un secondo accesso"

#: src/lib/launch.sh:291
#, sh-printf-format
msgid ""
"Confirm the second prompt in your authenticator app too. It comes in about "
"%d seconds."
msgstr ""
"Conferma anche la seconda richiesta nell'app di autenticazione. Arriva tra "
"circa %d secondi."

#: src/lib/launch.sh:301
#, sh-printf-format
msgid "%s could not start"
msgstr "Impossibile avviare %s"

#: src/lib/launch.sh:303
#, sh-printf-format
msgid "Log: %s"
msgstr "Log: %s"

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:93
msgid "[y/N]"
msgstr "[s/N]"

#: src/lib/menu.sh:163
msgid "1 app"
msgstr "1 app"

#: src/lib/menu.sh:165
#, sh-printf-format
msgid "%d apps"
msgstr "%d app"

#: src/lib/menu.sh:190
msgid "No workspace yet. Add the one of your company with [1]."
msgstr ""
"Nessuno spazio di lavoro ancora. Aggiungi quello della tua azienda con [1]."

#: src/lib/menu.sh:233
msgid "off"
msgstr "disattivo"

#: src/lib/menu.sh:234
msgid "home folder"
msgstr "cartella home"

#: src/lib/menu.sh:237
msgid "Documents"
msgstr "Documenti"

#: src/lib/menu.sh:238
msgid "Downloads"
msgstr "Download"

#: src/lib/menu.sh:243
msgid "not found"
msgstr "non trovata"

#: src/lib/menu.sh:246
#, sh-printf-format
msgid "automatic (%d %%)"
msgstr "automatica (%d %%)"

#: src/lib/menu.sh:248
msgid "classic"
msgstr "classico"

#: src/lib/menu.sh:249
msgid "GFX"
msgstr "GFX"

#: src/lib/menu.sh:250
msgid "always"
msgstr "sempre"

#: src/lib/menu.sh:252
msgid "automatic"
msgstr "automatico"

#: src/lib/menu.sh:261
msgid ""
"The apps only see the files on the server. Pick a folder to open and save "
"files of this computer in them."
msgstr ""
"Le app vedono solo i file sul server. Scegli una cartella perché possano "
"aprire e salvare file di questo computer."

#: src/lib/menu.sh:262
msgid ""
"The apps can open and save files in this folder. It shows up as a drive in "
"them."
msgstr ""
"Le app possono aprire e salvare file in questa cartella. Compare in esse "
"come un'unità."

#: src/lib/menu.sh:263
msgid ""
"Offers the apps under \"Open with\" for their file types, for example Word "
"for .docx. The folder of the file is shared with the app while it is open."
msgstr ""
"Offre le app in «Apri con» per i loro tipi di file, per esempio Word "
"per .docx. La cartella del file viene condivisa finché è aperto."

#: src/lib/menu.sh:264
msgid ""
"How big the apps are drawn. Automatic follows the scale of your desktop, so "
"they are sharp and the right size."
msgstr ""
"Quanto grandi vengono disegnate le app. Automatica segue la scala del "
"desktop, così sono nitide e della giusta dimensione."

#: src/lib/menu.sh:265
msgid "Plays the sound of the apps here, for calls and videos."
msgstr "Riproduce qui l'audio delle app, per chiamate e video."

#: src/lib/menu.sh:266
msgid ""
"Paints every window right. But some servers end the session right after "
"signing in, then go back to GFX."
msgstr "Disegna bene ogni finestra. Ma alcuni server chiudono la sessione subito dopo l'accesso: allora torna a GFX."

#: src/lib/menu.sh:267
msgid ""
"Works with every server. FreeRDP may not repaint a window after it was "
"minimized or resized."
msgstr "Funziona con ogni server. FreeRDP potrebbe non ridisegnare una finestra dopo averla ridotta o ridimensionata."

#: src/lib/menu.sh:268
msgid ""
"Always waits before the second sign-in. For when the second prompt does not "
"come with automatic."
msgstr ""
"Attende sempre prima del secondo accesso. Per quando con automatico la "
"seconda richiesta non arriva."

#: src/lib/menu.sh:269
msgid "Never waits. Right when your company has no MFA."
msgstr "Non attende mai. Giusto se la tua azienda non usa l'MFA."

#: src/lib/menu.sh:270
msgid ""
"Many servers with MFA need a second sign-in, and its prompt only comes after "
"a short wait. Automatic waits when the first sign-in took a while."
msgstr ""
"Molti server con MFA chiedono un secondo accesso, e la sua richiesta arriva "
"solo dopo una breve attesa. Automatico attende se il primo accesso ha "
"richiesto un po'."

#: src/lib/menu.sh:273
msgid ""
"Loads the list of apps again once a day, so new apps show up by themselves."
msgstr ""
"Ricarica l'elenco delle app una volta al giorno, così quelle nuove compaiono "
"da sole."

#: src/lib/menu.sh:275 src/lib/menu.sh:330
msgid "Needs a systemd user session."
msgstr "Serve una sessione utente di systemd."

#: src/lib/menu.sh:322 src/lib/menu.sh:325
msgid "Could not save the setting."
msgstr "Impossibile salvare l'impostazione."

#: src/lib/menu.sh:371 src/lib/menu.sh:609
msgid "Settings"
msgstr "Impostazioni"

#: src/lib/menu.sh:372
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ scegli   ←→ o Spazio: cambia   q: indietro"

#: src/lib/menu.sh:373
msgid "ON"
msgstr "ATTIVO"

#: src/lib/menu.sh:374
msgid "OFF"
msgstr "DISATTIVO"

#: src/lib/menu.sh:456 src/lib/menu.sh:608
msgid "Workspaces"
msgstr "Spazi di lavoro"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:458
msgid ""
"↑↓ select   r: refresh   s: sign in again   d: remove   a: add   q: back"
msgstr ""
"↑↓ scegli   r: aggiorna   s: accedi di nuovo   d: rimuovi   a: aggiungi   q: "
"indietro"

#: src/lib/menu.sh:459
msgid "No workspace yet. Press a to add one."
msgstr "Nessuno spazio di lavoro ancora. Premi a per aggiungerne uno."

#: src/lib/menu.sh:484
#, sh-printf-format
msgid "refreshed %s"
msgstr "aggiornato %s"

#: src/lib/menu.sh:512
#, sh-printf-format
msgid "Remove \"%s\" and its apps?"
msgstr "Rimuovere «%s» e le sue app?"

#: src/lib/menu.sh:536 src/lib/menu.sh:607
msgid "Start an app"
msgstr "Avvia un'app"

#: src/lib/menu.sh:537
msgid "↑↓ select   Enter: start   q: back"
msgstr "↑↓ scegli   Invio: avvia   q: indietro"

#: src/lib/menu.sh:538
msgid "No apps yet. Add a workspace first."
msgstr "Nessuna app ancora. Aggiungi prima uno spazio di lavoro."

#: src/lib/menu.sh:579
#, sh-printf-format
msgid "%s is starting. It opens in a window of its own."
msgstr "%s si sta avviando. Si apre in una finestra propria."

#: src/lib/menu.sh:606
msgid "Add a workspace"
msgstr "Aggiungi uno spazio di lavoro"

#: src/lib/menu.sh:610
msgid "Quit"
msgstr "Esci"

#: src/lib/workspace.sh:163
msgid "The server did not accept the user name or password."
msgstr "Il server non ha accettato il nome utente o la password."

#: src/lib/workspace.sh:164
#, sh-printf-format
msgid "Could not reach the server: %s"
msgstr "Impossibile raggiungere il server: %s"

#: src/lib/workspace.sh:165
#, sh-printf-format
msgid "There is no RD Web feed at %s."
msgstr "Non c'è nessun feed RD Web in %s."

#: src/lib/workspace.sh:166
#, sh-printf-format
msgid "Could not load the apps: %s"
msgstr "Impossibile caricare le app: %s"

#: src/lib/workspace.sh:282
#, sh-printf-format
msgid "Remote desktop of %s"
msgstr "Desktop remoto di %s"

#: src/lib/workspace.sh:284
#, sh-printf-format
msgid "%s from %s"
msgstr "%s di %s"

