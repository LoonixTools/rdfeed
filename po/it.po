msgid "Apps"
msgstr "App"

#: src/lib/menu.sh
msgid "Share a folder"
msgstr "Condividi una cartella"

#: src/lib/menu.sh
msgid "Open files with the apps"
msgstr "Apri i file con le app"

#: src/lib/menu.sh
msgid "Size"
msgstr "Dimensione"

#: src/lib/menu.sh
msgid "Sound"
msgstr "Audio"

#: src/lib/menu.sh
msgid "Graphics"
msgstr "Grafica"

#: src/lib/menu.sh
msgid "Signing in"
msgstr "Accesso"

#: src/lib/menu.sh
msgid "Wait for the second MFA prompt"
msgstr "Attendi la seconda richiesta MFA"

#: src/lib/menu.sh
msgid "Refresh the apps every day"
msgstr "Aggiorna le app ogni giorno"
