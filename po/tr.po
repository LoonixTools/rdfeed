#: src/rdfeed:79 src/rdfeed:103
#, sh-printf-format
msgid "Could not write to %s."
msgstr "%s konumuna yazılamadı."

#: src/rdfeed:82
#, sh-printf-format
msgid "Signing in to %s…"
msgstr "%s üzerinde oturum açılıyor…"

#: src/rdfeed:100
msgid ""
"The password could not be saved in the keyring, so each app asks for it."
msgstr ""
"Parola anahtarlığa kaydedilemedi, bu yüzden her uygulama parolayı soracak."

#: src/rdfeed:111
#, sh-printf-format
msgid "1 app from %s is now in your app menu."
msgstr "%s kaynağından 1 uygulama artık uygulama menünüzde."

#: src/rdfeed:113
#, sh-printf-format
msgid "%d apps from %s are now in your app menu."
msgstr "%d uygulama (%s) artık uygulama menünüzde."

#: src/rdfeed:129
msgid ""
"Your IT department has the address. A work e-mail address often works too."
msgstr "Adres BT bölümünüzde. Çoğu zaman iş e-posta adresiniz de işe yarar."

#: src/rdfeed:130
msgid "Feed address, server or e-mail:"
msgstr "Akış adresi, sunucu ya da e-posta:"

#: src/rdfeed:137
#, sh-printf-format
msgid "No feed is registered for %s. Ask your IT department for the address."
msgstr "%s için kayıtlı bir akış yok. Adresi BT bölümünüze sorun."

#: src/rdfeed:142 src/rdfeed:156
msgid "User name (DOMAIN\\name or name@domain):"
msgstr "Kullanıcı adı (ALAN\\ad ya da ad@alan):"

#: src/rdfeed:146 src/rdfeed:159
msgid "Password:"
msgstr "Parola:"

#: src/rdfeed:178 src/rdfeed:236
#, sh-printf-format
msgid "No workspace yet. Add one with `%s add`."
msgstr "Henüz çalışma alanı yok. `%s add` ile bir tane ekleyin."

#: src/rdfeed:187 src/lib/launch.sh:220
#, sh-printf-format
msgid "No password saved for %s. Sign in again in rdfeed."
msgstr "%s için kayıtlı parola yok. rdfeed içinde yeniden oturum açın."

#: src/rdfeed:191 src/lib/launch.sh:149
#, sh-printf-format
msgid "Password for %s:"
msgstr "%s parolası:"

#: src/rdfeed:195
#, sh-printf-format
msgid "Refreshing %s…"
msgstr "%s yenileniyor…"

#: src/rdfeed:205
msgid "The password no longer works. Sign in again in rdfeed."
msgstr "Parola artık çalışmıyor. rdfeed içinde yeniden oturum açın."

#: src/rdfeed:214
#, sh-printf-format
msgid "%s: %d apps"
msgstr "%s: %d uygulama"

#: src/rdfeed:222
#, sh-printf-format
msgid "Which workspace? See `%s list` for the names."
msgstr "Hangi çalışma alanı? Adları `%s list` gösterir."

#: src/rdfeed:229
#, sh-printf-format
msgid "%s and its apps are removed."
msgstr "%s ve uygulamaları kaldırıldı."

#: src/rdfeed:253
#, sh-printf-format
msgid "Which app? See `%s list`."
msgstr "Hangi uygulama? `%s list` komutuna bakın."

#: src/rdfeed:268 src/lib/launch.sh:199
#, sh-printf-format
msgid "There is no app %s. See `%s list`."
msgstr "%s diye bir uygulama yok. `%s list` komutuna bakın."

#: src/rdfeed:270
#, sh-printf-format
msgid "Several workspaces have %s. Write it as WORKSPACE/APP, see `%s list`."
msgstr ""
"%s birden çok çalışma alanında var. ÇALIŞMA_ALANI/UYGULAMA biçiminde yazın, "
"`%s list` komutuna bakın."

#: src/rdfeed:278
msgid "Usage: rdfeed [command]"
msgstr "Kullanım: rdfeed [komut]"

#: src/rdfeed:280
msgid "Commands:"
msgstr "Komutlar:"

#: src/rdfeed:281
msgid "Add the workspace of your company"
msgstr "Şirketinizin çalışma alanını ekle"

#: src/rdfeed:282
msgid "Load the apps again"
msgstr "Uygulamaları yeniden yükle"

#: src/rdfeed:283
msgid "List the workspaces and their apps"
msgstr "Çalışma alanlarını ve uygulamalarını listele"

#: src/rdfeed:284
msgid "Start an app, or open a file with it"
msgstr "Bir uygulama başlat ya da onunla bir dosya aç"

#: src/rdfeed:285
msgid "Remove a workspace and its apps"
msgstr "Bir çalışma alanını ve uygulamalarını kaldır"

#: src/rdfeed:286
msgid "Show this help"
msgstr "Bu yardımı göster"

#: src/rdfeed:287
msgid "Show the version"
msgstr "Sürümü göster"

#: src/rdfeed:289
msgid "Without a command an interactive menu is shown."
msgstr "Komut verilmezse etkileşimli bir menü gösterilir."

#: src/rdfeed:313
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Bilinmeyen komut: %s"

#: src/lib/common.sh:174 src/lib/menu.sh:251
msgid "never"
msgstr "hiçbir zaman"

#: src/lib/common.sh:184
msgid "just now"
msgstr "az önce"

#: src/lib/common.sh:186
msgid "1 minute ago"
msgstr "1 dakika önce"

#: src/lib/common.sh:189
#, sh-printf-format
msgid "%d minutes ago"
msgstr "%d dakika önce"

#: src/lib/common.sh:191
msgid "1 hour ago"
msgstr "1 saat önce"

#: src/lib/common.sh:194
#, sh-printf-format
msgid "%d hours ago"
msgstr "%d saat önce"

#: src/lib/common.sh:196
msgid "1 day ago"
msgstr "1 gün önce"

#: src/lib/common.sh:199
#, sh-printf-format
msgid "%d days ago"
msgstr "%d gün önce"

#: src/lib/launch.sh:169
msgid ""
"Your password has expired. Change it on Windows or on the RD Web page, then "
"sign in again in rdfeed."
msgstr ""
"Parolanızın süresi doldu. Windows'ta ya da RD Web sayfasında değiştirin, "
"sonra rdfeed içinde yeniden oturum açın."

#: src/lib/launch.sh:171
msgid "Your account is locked. Ask your IT department."
msgstr "Hesabınız kilitli. BT bölümünüze sorun."

#: src/lib/launch.sh:173
msgid "The server did not accept the password. Sign in again in rdfeed."
msgstr "Sunucu parolayı kabul etmedi. rdfeed içinde yeniden oturum açın."

#: src/lib/launch.sh:175
msgid "Could not reach the server. Check the internet connection."
msgstr "Sunucuya ulaşılamadı. İnternet bağlantısını kontrol edin."

#: src/lib/launch.sh:178
#, sh-printf-format
msgid "FreeRDP stopped: %s"
msgstr "FreeRDP durdu: %s"

#: src/lib/launch.sh:205 src/lib/launch.sh:206
#, sh-printf-format
msgid "File not found: %s"
msgstr "Dosya bulunamadı: %s"

#: src/lib/launch.sh:212 src/lib/launch.sh:213
msgid ""
"FreeRDP 3 is missing. Install it to start the apps (the package is called "
"freerdp)."
msgstr ""
"FreeRDP 3 eksik. Uygulamaları başlatmak için kurun (paketin adı freerdp)."

#: src/lib/launch.sh:277
#, sh-printf-format
msgid "Opening %s in %s"
msgstr "%s, %s ile açılıyor"

#: src/lib/launch.sh:278
#, sh-printf-format
msgid "If it does not open by itself, open it in the app from the drive %s."
msgstr "Kendiliğinden açılmazsa uygulamada %s sürücüsünden açın."

#: src/lib/launch.sh:280
#, sh-printf-format
msgid "Starting %s"
msgstr "%s başlatılıyor"

#: src/lib/launch.sh:281
msgid ""
"If your company uses MFA, confirm the sign-in in your authenticator app."
msgstr ""
"Şirketiniz MFA kullanıyorsa doğrulama uygulamanızda oturum açmayı onaylayın."

#: src/lib/launch.sh:290
msgid "A second sign-in is coming"
msgstr "İkinci bir oturum açma geliyor"

#: src/lib/launch.sh:291
#, sh-printf-format
msgid ""
"Confirm the second prompt in your authenticator app too. It comes in about "
"%d seconds."
msgstr ""
"İkinci isteği de doğrulama uygulamanızda onaylayın. Yaklaşık %d saniye "
"içinde gelir."

#: src/lib/launch.sh:301
#, sh-printf-format
msgid "%s could not start"
msgstr "%s başlatılamadı"

#: src/lib/launch.sh:303
#, sh-printf-format
msgid "Log: %s"
msgstr "Günlük: %s"

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:93
msgid "[y/N]"
msgstr "[e/H]"

#: src/lib/menu.sh:163
msgid "1 app"
msgstr "1 uygulama"

#: src/lib/menu.sh:165
#, sh-printf-format
msgid "%d apps"
msgstr "%d uygulama"

#: src/lib/menu.sh:190
msgid "No workspace yet. Add the one of your company with [1]."
msgstr "Henüz çalışma alanı yok. Şirketinizinkini [1] ile ekleyin."

#: src/lib/menu.sh:233
msgid "off"
msgstr "kapalı"

#: src/lib/menu.sh:234
msgid "home folder"
msgstr "ev klasörü"

#: src/lib/menu.sh:237
msgid "Documents"
msgstr "Belgeler"

#: src/lib/menu.sh:238
msgid "Downloads"
msgstr "İndirilenler"

#: src/lib/menu.sh:243
msgid "not found"
msgstr "bulunamadı"

#: src/lib/menu.sh:246
#, sh-printf-format
msgid "automatic (%d %%)"
msgstr "otomatik (%%%d)"

#: src/lib/menu.sh:248
msgid "classic"
msgstr "klasik"

#: src/lib/menu.sh:249
msgid "GFX"
msgstr "GFX"

#: src/lib/menu.sh:250
msgid "always"
msgstr "her zaman"

#: src/lib/menu.sh:252
msgid "automatic"
msgstr "otomatik"

#: src/lib/menu.sh:261
msgid ""
"The apps only see the files on the server. Pick a folder to open and save "
"files of this computer in them."
msgstr ""
"Uygulamalar yalnızca sunucudaki dosyaları görür. Bu bilgisayarın dosyalarını "
"açıp kaydedebilmeleri için bir klasör seçin."

#: src/lib/menu.sh:262
msgid ""
"The apps can open and save files in this folder. It shows up as a drive in "
"them."
msgstr ""
"Uygulamalar bu klasörde dosya açıp kaydedebilir. Klasör onlarda bir sürücü "
"olarak görünür."

#: src/lib/menu.sh:263
msgid ""
"Offers the apps under \"Open with\" for their file types, for example Word "
"for .docx. The folder of the file is shared with the app while it is open."
msgstr ""
"Uygulamaları dosya türleri için \"Birlikte aç\" menüsünde sunar, "
"örneğin .docx için Word. Dosya açık olduğu sürece klasörü paylaşılır."

#: src/lib/menu.sh:264
msgid ""
"How big the apps are drawn. Automatic follows the scale of your desktop, so "
"they are sharp and the right size."
msgstr ""
"Uygulamaların ne kadar büyük çizileceği. Otomatik, masaüstünüzün ölçeğini "
"izler; böylece keskin ve doğru boyutta olurlar."

#: src/lib/menu.sh:265
msgid "Plays the sound of the apps here, for calls and videos."
msgstr "Uygulamaların sesini burada çalar; aramalar ve videolar için."

#: src/lib/menu.sh:266
msgid ""
"Paints every window right. But some servers end the session right after "
"signing in, then go back to GFX."
msgstr "Her pencereyi doğru çizer. Ama bazı sunucular oturum açar açmaz oturumu kapatır, o zaman GFX'e geri dönün."

#: src/lib/menu.sh:267
msgid ""
"Works with every server. FreeRDP may not repaint a window after it was "
"minimized or resized."
msgstr "Her sunucuyla çalışır. FreeRDP küçültülen ya da boyutu değişen bir pencereyi yeniden çizmeyebilir."

#: src/lib/menu.sh:268
msgid ""
"Always waits before the second sign-in. For when the second prompt does not "
"come with automatic."
msgstr ""
"İkinci oturum açmadan önce hep bekler. Otomatikte ikinci istek gelmiyorsa "
"kullanın."

#: src/lib/menu.sh:269
msgid "Never waits. Right when your company has no MFA."
msgstr "Hiç beklemez. Şirketiniz MFA kullanmıyorsa doğru seçim."

#: src/lib/menu.sh:270
msgid ""
"Many servers with MFA need a second sign-in, and its prompt only comes after "
"a short wait. Automatic waits when the first sign-in took a while."
msgstr ""
"MFA kullanan birçok sunucu ikinci bir oturum açma ister ve isteği ancak kısa "
"bir beklemeden sonra gelir. Otomatik, ilk oturum açma biraz sürdüyse bekler."

#: src/lib/menu.sh:273
msgid ""
"Loads the list of apps again once a day, so new apps show up by themselves."
msgstr ""
"Uygulama listesini günde bir kez yeniden yükler; böylece yeni uygulamalar "
"kendiliğinden görünür."

#: src/lib/menu.sh:275 src/lib/menu.sh:330
msgid "Needs a systemd user session."
msgstr "Bir systemd kullanıcı oturumu gerekir."

#: src/lib/menu.sh:322 src/lib/menu.sh:325
msgid "Could not save the setting."
msgstr "Ayar kaydedilemedi."

#: src/lib/menu.sh:371 src/lib/menu.sh:609
msgid "Settings"
msgstr "Ayarlar"

#: src/lib/menu.sh:372
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ seç   ←→ ya da Boşluk: değiştir   q: geri"

#: src/lib/menu.sh:373
msgid "ON"
msgstr "AÇIK"

#: src/lib/menu.sh:374
msgid "OFF"
msgstr "KAPALI"

#: src/lib/menu.sh:456 src/lib/menu.sh:608
msgid "Workspaces"
msgstr "Çalışma alanları"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:458
msgid ""
"↑↓ select   r: refresh   s: sign in again   d: remove   a: add   q: back"
msgstr ""
"↑↓ seç   r: yenile   s: yeniden oturum aç   d: kaldır   a: ekle   q: geri"

#: src/lib/menu.sh:459
msgid "No workspace yet. Press a to add one."
msgstr "Henüz çalışma alanı yok. Eklemek için a tuşuna basın."

#: src/lib/menu.sh:484
#, sh-printf-format
msgid "refreshed %s"
msgstr "%s yenilendi"

#: src/lib/menu.sh:512
#, sh-printf-format
msgid "Remove \"%s\" and its apps?"
msgstr "\"%s\" ve uygulamaları kaldırılsın mı?"

#: src/lib/menu.sh:536 src/lib/menu.sh:607
msgid "Start an app"
msgstr "Bir uygulama başlat"

#: src/lib/menu.sh:537
msgid "↑↓ select   Enter: start   q: back"
msgstr "↑↓ seç   Enter: başlat   q: geri"

#: src/lib/menu.sh:538
msgid "No apps yet. Add a workspace first."
msgstr "Henüz uygulama yok. Önce bir çalışma alanı ekleyin."

#: src/lib/menu.sh:579
#, sh-printf-format
msgid "%s is starting. It opens in a window of its own."
msgstr "%s başlatılıyor. Kendi penceresinde açılır."

#: src/lib/menu.sh:606
msgid "Add a workspace"
msgstr "Çalışma alanı ekle"

#: src/lib/menu.sh:610
msgid "Quit"
msgstr "Çık"

#: src/lib/workspace.sh:163
msgid "The server did not accept the user name or password."
msgstr "Sunucu kullanıcı adını ya da parolayı kabul etmedi."

#: src/lib/workspace.sh:164
#, sh-printf-format
msgid "Could not reach the server: %s"
msgstr "Sunucuya ulaşılamadı: %s"

#: src/lib/workspace.sh:165
#, sh-printf-format
msgid "There is no RD Web feed at %s."
msgstr "%s adresinde RD Web akışı yok."

#: src/lib/workspace.sh:166
#, sh-printf-format
msgid "Could not load the apps: %s"
msgstr "Uygulamalar yüklenemedi: %s"

#: src/lib/workspace.sh:282
#, sh-printf-format
msgid "Remote desktop of %s"
msgstr "%s uzak masaüstü"

#: src/lib/workspace.sh:284
#, sh-printf-format
msgid "%s from %s"
msgstr "%s (%s)"

#: src/lib/menu.sh
msgid "Apps"
msgstr "Uygulamalar"

#: src/lib/menu.sh
msgid "Share a folder"
msgstr "Klasör paylaş"

#: src/lib/menu.sh
msgid "Open files with the apps"
msgstr "Dosyaları uygulamalarla aç"

#: src/lib/menu.sh
msgid "Size"
msgstr "Boyut"

#: src/lib/menu.sh
msgid "Sound"
msgstr "Ses"

#: src/lib/menu.sh
msgid "Graphics"
msgstr "Grafik"

#: src/lib/menu.sh
msgid "Signing in"
msgstr "Oturum açma"

#: src/lib/menu.sh
msgid "Wait for the second MFA prompt"
msgstr "İkinci MFA isteğini bekle"

#: src/lib/menu.sh
msgid "Refresh the apps every day"
msgstr "Uygulamaları her gün yenile"
