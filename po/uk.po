#: src/rdfeed:79 src/rdfeed:103
#, sh-printf-format
msgid "Could not write to %s."
msgstr "Не вдалося записати в %s."

#: src/rdfeed:82
#, sh-printf-format
msgid "Signing in to %s…"
msgstr "Вхід на %s…"

#: src/rdfeed:100
msgid ""
"The password could not be saved in the keyring, so each app asks for it."
msgstr ""
"Не вдалося зберегти пароль у в'язці ключів, тож кожен застосунок питатиме "
"його."

#: src/rdfeed:111
#, sh-printf-format
msgid "1 app from %s is now in your app menu."
msgstr "1 застосунок із %s тепер у меню застосунків."

#: src/rdfeed:113
#, sh-printf-format
msgid "%d apps from %s are now in your app menu."
msgstr "Застосунків: %d (із %s). Тепер вони в меню застосунків."

#: src/rdfeed:129
msgid ""
"Your IT department has the address. A work e-mail address often works too."
msgstr ""
"Адресу має ваш ІТ-відділ. Часто підходить і робоча адреса електронної пошти."

#: src/rdfeed:130
msgid "Feed address, server or e-mail:"
msgstr "Адреса фіда, сервер або e-mail:"

#: src/rdfeed:137
#, sh-printf-format
msgid "No feed is registered for %s. Ask your IT department for the address."
msgstr "Для %s не зареєстровано фід. Запитайте адресу в ІТ-відділі."

#: src/rdfeed:142 src/rdfeed:156
msgid "User name (DOMAIN\\name or name@domain):"
msgstr "Ім'я користувача (ДОМЕН\\ім'я або ім'я@домен):"

#: src/rdfeed:146 src/rdfeed:159
msgid "Password:"
msgstr "Пароль:"

#: src/rdfeed:178 src/rdfeed:236
#, sh-printf-format
msgid "No workspace yet. Add one with `%s add`."
msgstr "Робочих просторів ще немає. Додайте його командою `%s add`."

#: src/rdfeed:187 src/lib/launch.sh:220
#, sh-printf-format
msgid "No password saved for %s. Sign in again in rdfeed."
msgstr "Для %s не збережено пароль. Увійдіть знову в rdfeed."

#: src/rdfeed:191 src/lib/launch.sh:149
#, sh-printf-format
msgid "Password for %s:"
msgstr "Пароль для %s:"

#: src/rdfeed:195
#, sh-printf-format
msgid "Refreshing %s…"
msgstr "Оновлення %s…"

#: src/rdfeed:205
msgid "The password no longer works. Sign in again in rdfeed."
msgstr "Пароль більше не підходить. Увійдіть знову в rdfeed."

#: src/rdfeed:214
#, sh-printf-format
msgid "%s: %d apps"
msgstr "%s: застосунків: %d"

#: src/rdfeed:222
#, sh-printf-format
msgid "Which workspace? See `%s list` for the names."
msgstr "Який робочий простір? Назви показує `%s list`."

#: src/rdfeed:229
#, sh-printf-format
msgid "%s and its apps are removed."
msgstr "Видалено: %s разом із застосунками."

#: src/rdfeed:253
#, sh-printf-format
msgid "Which app? See `%s list`."
msgstr "Який застосунок? Дивіться `%s list`."

#: src/rdfeed:268 src/lib/launch.sh:199
#, sh-printf-format
msgid "There is no app %s. See `%s list`."
msgstr "Застосунку %s немає. Дивіться `%s list`."

#: src/rdfeed:270
#, sh-printf-format
msgid "Several workspaces have %s. Write it as WORKSPACE/APP, see `%s list`."
msgstr ""
"%s є в кількох робочих просторах. Вкажіть у вигляді ПРОСТІР/ЗАСТОСУНОК, "
"дивіться `%s list`."

#: src/rdfeed:278
msgid "Usage: rdfeed [command]"
msgstr "Використання: rdfeed [команда]"

#: src/rdfeed:280
msgid "Commands:"
msgstr "Команди:"

#: src/rdfeed:281
msgid "Add the workspace of your company"
msgstr "Додати робочий простір вашої компанії"

#: src/rdfeed:282
msgid "Load the apps again"
msgstr "Завантажити застосунки знову"

#: src/rdfeed:283
msgid "List the workspaces and their apps"
msgstr "Показати робочі простори та їхні застосунки"

#: src/rdfeed:284
msgid "Start an app, or open a file with it"
msgstr "Запустити застосунок або відкрити в ньому файл"

#: src/rdfeed:285
msgid "Remove a workspace and its apps"
msgstr "Видалити робочий простір і його застосунки"

#: src/rdfeed:286
msgid "Show this help"
msgstr "Показати цю довідку"

#: src/rdfeed:287
msgid "Show the version"
msgstr "Показати версію"

#: src/rdfeed:289
msgid "Without a command an interactive menu is shown."
msgstr "Без команди відкривається інтерактивне меню."

#: src/rdfeed:313
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Невідома команда: %s"

#: src/lib/common.sh:174 src/lib/menu.sh:251
msgid "never"
msgstr "ніколи"

#: src/lib/common.sh:184
msgid "just now"
msgstr "щойно"

#: src/lib/common.sh:186
msgid "1 minute ago"
msgstr "1 хвилину тому"

#: src/lib/common.sh:189
#, sh-printf-format
msgid "%d minutes ago"
msgstr "%d хв тому"

#: src/lib/common.sh:191
msgid "1 hour ago"
msgstr "1 годину тому"

#: src/lib/common.sh:194
#, sh-printf-format
msgid "%d hours ago"
msgstr "%d год тому"

#: src/lib/common.sh:196
msgid "1 day ago"
msgstr "1 день тому"

#: src/lib/common.sh:199
#, sh-printf-format
msgid "%d days ago"
msgstr "%d дн. тому"

#: src/lib/launch.sh:169
msgid ""
"Your password has expired. Change it on Windows or on the RD Web page, then "
"sign in again in rdfeed."
msgstr ""
"Термін дії пароля минув. Змініть його у Windows або на сторінці RD Web, "
"потім знову увійдіть у rdfeed."

#: src/lib/launch.sh:171
msgid "Your account is locked. Ask your IT department."
msgstr "Обліковий запис заблоковано. Зверніться до ІТ-відділу."

#: src/lib/launch.sh:173
msgid "The server did not accept the password. Sign in again in rdfeed."
msgstr "Сервер не прийняв пароль. Увійдіть знову в rdfeed."

#: src/lib/launch.sh:175
msgid "Could not reach the server. Check the internet connection."
msgstr "Не вдалося зв'язатися із сервером. Перевірте підключення до інтернету."

#: src/lib/launch.sh:178
#, sh-printf-format
msgid "FreeRDP stopped: %s"
msgstr "FreeRDP зупинився: %s"

#: src/lib/launch.sh:205 src/lib/launch.sh:206
#, sh-printf-format
msgid "File not found: %s"
msgstr "Файл не знайдено: %s"

#: src/lib/launch.sh:212 src/lib/launch.sh:213
msgid ""
"FreeRDP 3 is missing. Install it to start the apps (the package is called "
"freerdp)."
msgstr ""
"Немає FreeRDP 3. Установіть його, щоб запускати застосунки (пакет "
"називається freerdp)."

#: src/lib/launch.sh:277
#, sh-printf-format
msgid "Opening %s in %s"
msgstr "Відкриття %s у %s"

#: src/lib/launch.sh:278
#, sh-printf-format
msgid "If it does not open by itself, open it in the app from the drive %s."
msgstr "Якщо файл не відкриється сам, відкрийте його в застосунку з диска %s."

#: src/lib/launch.sh:280
#, sh-printf-format
msgid "Starting %s"
msgstr "Запуск: %s"

#: src/lib/launch.sh:281
msgid ""
"If your company uses MFA, confirm the sign-in in your authenticator app."
msgstr ""
"Якщо ваша компанія використовує MFA, підтвердьте вхід у застосунку "
"автентифікації."

#: src/lib/launch.sh:290
msgid "A second sign-in is coming"
msgstr "Буде другий вхід"

#: src/lib/launch.sh:291
#, sh-printf-format
msgid ""
"Confirm the second prompt in your authenticator app too. It comes in about "
"%d seconds."
msgstr ""
"Підтвердьте і другий запит у застосунку автентифікації. Він надійде "
"приблизно за %d с."

#: src/lib/launch.sh:301
#, sh-printf-format
msgid "%s could not start"
msgstr "Не вдалося запустити: %s"

#: src/lib/launch.sh:303
#, sh-printf-format
msgid "Log: %s"
msgstr "Журнал: %s"

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:93
msgid "[y/N]"
msgstr "[т/Н]"

#: src/lib/menu.sh:163
msgid "1 app"
msgstr "1 застосунок"

#: src/lib/menu.sh:165
#, sh-printf-format
msgid "%d apps"
msgstr "застосунків: %d"

#: src/lib/menu.sh:190
msgid "No workspace yet. Add the one of your company with [1]."
msgstr "Робочих просторів ще немає. Додайте простір вашої компанії через [1]."

#: src/lib/menu.sh:233
msgid "off"
msgstr "вимк."

#: src/lib/menu.sh:234
msgid "home folder"
msgstr "домашня тека"

#: src/lib/menu.sh:237
msgid "Documents"
msgstr "Документи"

#: src/lib/menu.sh:238
msgid "Downloads"
msgstr "Завантаження"

#: src/lib/menu.sh:243
msgid "not found"
msgstr "не знайдено"

#: src/lib/menu.sh:246
#, sh-printf-format
msgid "automatic (%d %%)"
msgstr "автоматично (%d %%)"

#: src/lib/menu.sh:248
msgid "classic"
msgstr "класичний"

#: src/lib/menu.sh:249
msgid "GFX"
msgstr "GFX"

#: src/lib/menu.sh:250
msgid "always"
msgstr "завжди"

#: src/lib/menu.sh:252
msgid "automatic"
msgstr "автоматично"

#: src/lib/menu.sh:261
msgid ""
"The apps only see the files on the server. Pick a folder to open and save "
"files of this computer in them."
msgstr ""
"Застосунки бачать лише файли на сервері. Виберіть теку, щоб вони могли "
"відкривати й зберігати файли цього комп'ютера."

#: src/lib/menu.sh:262
msgid ""
"The apps can open and save files in this folder. It shows up as a drive in "
"them."
msgstr ""
"Застосунки можуть відкривати й зберігати файли в цій теці. У них вона видна "
"як диск."

#: src/lib/menu.sh:263
msgid ""
"Offers the apps under \"Open with\" for their file types, for example Word "
"for .docx. The folder of the file is shared with the app while it is open."
msgstr ""
"Пропонує застосунки в «Відкрити за допомогою» для їхніх типів файлів, "
"наприклад Word для .docx. Тека файлу відкрита для сервера, доки файл "
"відкритий."

#: src/lib/menu.sh:264
msgid ""
"How big the apps are drawn. Automatic follows the scale of your desktop, so "
"they are sharp and the right size."
msgstr ""
"Наскільки великими малюються застосунки. «Автоматично» стежить за масштабом "
"стільниці, тож вони чіткі й потрібного розміру."

#: src/lib/menu.sh:265
msgid "Plays the sound of the apps here, for calls and videos."
msgstr "Відтворює звук застосунків тут, для дзвінків і відео."

#: src/lib/menu.sh:266
msgid ""
"Paints every window right. But some servers end the session right after "
"signing in, then go back to GFX."
msgstr "Правильно малює кожне вікно. Але деякі сервери обривають сеанс одразу після входу, тоді поверніться до GFX."

#: src/lib/menu.sh:267
msgid ""
"Works with every server. FreeRDP may not repaint a window after it was "
"minimized or resized."
msgstr "Працює з будь-яким сервером. FreeRDP може не перемалювати вікно після згортання чи зміни розміру."

#: src/lib/menu.sh:268
msgid ""
"Always waits before the second sign-in. For when the second prompt does not "
"come with automatic."
msgstr ""
"Завжди чекає перед другим входом. Якщо з «автоматично» другий запит не "
"надходить."

#: src/lib/menu.sh:269
msgid "Never waits. Right when your company has no MFA."
msgstr "Ніколи не чекає. Підходить, якщо ваша компанія не використовує MFA."

#: src/lib/menu.sh:270
msgid ""
"Many servers with MFA need a second sign-in, and its prompt only comes after "
"a short wait. Automatic waits when the first sign-in took a while."
msgstr ""
"Багатьом серверам з MFA потрібен другий вхід, і його запит надходить лише "
"після короткої паузи. «Автоматично» чекає, якщо перший вхід тривав якийсь "
"час."

#: src/lib/menu.sh:273
msgid ""
"Loads the list of apps again once a day, so new apps show up by themselves."
msgstr ""
"Раз на день заново завантажує список застосунків, тож нові з'являються самі."

#: src/lib/menu.sh:275 src/lib/menu.sh:330
msgid "Needs a systemd user session."
msgstr "Потрібен користувацький сеанс systemd."

#: src/lib/menu.sh:322 src/lib/menu.sh:325
msgid "Could not save the setting."
msgstr "Не вдалося зберегти налаштування."

#: src/lib/menu.sh:371 src/lib/menu.sh:609
msgid "Settings"
msgstr "Налаштування"

#: src/lib/menu.sh:372
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ вибір   ←→ або Пробіл: змінити   q: назад"

#: src/lib/menu.sh:373
msgid "ON"
msgstr "УВІМК"

#: src/lib/menu.sh:374
msgid "OFF"
msgstr "ВИМК"

#: src/lib/menu.sh:456 src/lib/menu.sh:608
msgid "Workspaces"
msgstr "Робочі простори"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:458
msgid ""
"↑↓ select   r: refresh   s: sign in again   d: remove   a: add   q: back"
msgstr ""
"↑↓ вибір   r: оновити   s: увійти знову   d: видалити   a: додати   q: назад"

#: src/lib/menu.sh:459
msgid "No workspace yet. Press a to add one."
msgstr "Робочих просторів ще немає. Натисніть a, щоб додати."

#: src/lib/menu.sh:484
#, sh-printf-format
msgid "refreshed %s"
msgstr "оновлено %s"

#: src/lib/menu.sh:512
#, sh-printf-format
msgid "Remove \"%s\" and its apps?"
msgstr "Видалити «%s» разом із застосунками?"

#: src/lib/menu.sh:536 src/lib/menu.sh:607
msgid "Start an app"
msgstr "Запустити застосунок"

#: src/lib/menu.sh:537
msgid "↑↓ select   Enter: start   q: back"
msgstr "↑↓ вибір   Enter: запустити   q: назад"

#: src/lib/menu.sh:538
msgid "No apps yet. Add a workspace first."
msgstr "Застосунків ще немає. Спершу додайте робочий простір."

#: src/lib/menu.sh:579
#, sh-printf-format
msgid "%s is starting. It opens in a window of its own."
msgstr "Запуск: %s. Відкриється в окремому вікні."

#: src/lib/menu.sh:606
msgid "Add a workspace"
msgstr "Додати робочий простір"

#: src/lib/menu.sh:610
msgid "Quit"
msgstr "Вийти"

#: src/lib/workspace.sh:163
msgid "The server did not accept the user name or password."
msgstr "Сервер не прийняв ім'я користувача або пароль."

#: src/lib/workspace.sh:164
#, sh-printf-format
msgid "Could not reach the server: %s"
msgstr "Не вдалося зв'язатися із сервером: %s"

#: src/lib/workspace.sh:165
#, sh-printf-format
msgid "There is no RD Web feed at %s."
msgstr "За адресою %s немає фіда RD Web."

#: src/lib/workspace.sh:166
#, sh-printf-format
msgid "Could not load the apps: %s"
msgstr "Не вдалося завантажити застосунки: %s"

#: src/lib/workspace.sh:282
#, sh-printf-format
msgid "Remote desktop of %s"
msgstr "Віддалена стільниця %s"

#: src/lib/workspace.sh:284
#, sh-printf-format
msgid "%s from %s"
msgstr "%s із %s"

#: src/lib/menu.sh
msgid "Apps"
msgstr "Застосунки"

#: src/lib/menu.sh
msgid "Share a folder"
msgstr "Спільна тека"

#: src/lib/menu.sh
msgid "Open files with the apps"
msgstr "Відкривати файли в застосунках"

#: src/lib/menu.sh
msgid "Size"
msgstr "Розмір"

#: src/lib/menu.sh
msgid "Sound"
msgstr "Звук"

#: src/lib/menu.sh
msgid "Graphics"
msgstr "Графіка"

#: src/lib/menu.sh
msgid "Signing in"
msgstr "Вхід"

#: src/lib/menu.sh
msgid "Wait for the second MFA prompt"
msgstr "Чекати на другий запит MFA"

#: src/lib/menu.sh
msgid "Refresh the apps every day"
msgstr "Оновлювати застосунки щодня"
