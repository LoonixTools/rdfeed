#: src/rdfeed:79 src/rdfeed:103
#, sh-printf-format
msgid "Could not write to %s."
msgstr "Impossible d'écrire dans %s."

#: src/rdfeed:82
#, sh-printf-format
msgid "Signing in to %s…"
msgstr "Connexion à %s…"

#: src/rdfeed:100
msgid ""
"The password could not be saved in the keyring, so each app asks for it."
msgstr ""
"Le mot de passe n'a pas pu être enregistré dans le trousseau, chaque "
"application le demandera donc."

#: src/rdfeed:111
#, sh-printf-format
msgid "1 app from %s is now in your app menu."
msgstr "1 application de %s est maintenant dans votre menu des applications."

#: src/rdfeed:113
#, sh-printf-format
msgid "%d apps from %s are now in your app menu."
msgstr ""
"%d applications de %s sont maintenant dans votre menu des applications."

#: src/rdfeed:129
msgid ""
"Your IT department has the address. A work e-mail address often works too."
msgstr ""
"Votre service informatique connaît l'adresse. Souvent, votre adresse e-mail "
"professionnelle fonctionne aussi."

#: src/rdfeed:130
msgid "Feed address, server or e-mail:"
msgstr "Adresse du flux, serveur ou e-mail :"

#: src/rdfeed:137
#, sh-printf-format
msgid "No feed is registered for %s. Ask your IT department for the address."
msgstr ""
"Aucun flux n'est enregistré pour %s. Demandez l'adresse à votre service "
"informatique."

#: src/rdfeed:142 src/rdfeed:156
msgid "User name (DOMAIN\\name or name@domain):"
msgstr "Nom d'utilisateur (DOMAINE\\nom ou nom@domaine) :"

#: src/rdfeed:146 src/rdfeed:159
msgid "Password:"
msgstr "Mot de passe :"

#: src/rdfeed:178 src/rdfeed:236
#, sh-printf-format
msgid "No workspace yet. Add one with `%s add`."
msgstr "Aucun espace de travail pour l'instant. Ajoutez-en un avec `%s add`."

#: src/rdfeed:187 src/lib/launch.sh:220
#, sh-printf-format
msgid "No password saved for %s. Sign in again in rdfeed."
msgstr "Aucun mot de passe enregistré pour %s. Reconnectez-vous dans rdfeed."

#: src/rdfeed:191 src/lib/launch.sh:149
#, sh-printf-format
msgid "Password for %s:"
msgstr "Mot de passe pour %s :"

#: src/rdfeed:195
#, sh-printf-format
msgid "Refreshing %s…"
msgstr "Actualisation de %s…"

#: src/rdfeed:205
msgid "The password no longer works. Sign in again in rdfeed."
msgstr "Le mot de passe ne fonctionne plus. Reconnectez-vous dans rdfeed."

#: src/rdfeed:214
#, sh-printf-format
msgid "%s: %d apps"
msgstr "%s : %d applications"

#: src/rdfeed:222
#, sh-printf-format
msgid "Which workspace? See `%s list` for the names."
msgstr "Quel espace de travail ? Les noms sont dans `%s list`."

#: src/rdfeed:229
#, sh-printf-format
msgid "%s and its apps are removed."
msgstr "%s et ses applications ont été supprimés."

#: src/rdfeed:253
#, sh-printf-format
msgid "Which app? See `%s list`."
msgstr "Quelle application ? Voir `%s list`."

#: src/rdfeed:268 src/lib/launch.sh:199
#, sh-printf-format
msgid "There is no app %s. See `%s list`."
msgstr "L'application %s n'existe pas. Voir `%s list`."

#: src/rdfeed:270
#, sh-printf-format
msgid "Several workspaces have %s. Write it as WORKSPACE/APP, see `%s list`."
msgstr ""
"Plusieurs espaces de travail ont %s. Écrivez-le sous la forme ESPACE/"
"APPLICATION, voir `%s list`."

#: src/rdfeed:278
msgid "Usage: rdfeed [command]"
msgstr "Utilisation : rdfeed [commande]"

#: src/rdfeed:280
msgid "Commands:"
msgstr "Commandes :"

#: src/rdfeed:281
msgid "Add the workspace of your company"
msgstr "Ajouter l'espace de travail de votre entreprise"

#: src/rdfeed:282
msgid "Load the apps again"
msgstr "Recharger les applications"

#: src/rdfeed:283
msgid "List the workspaces and their apps"
msgstr "Lister les espaces de travail et leurs applications"

#: src/rdfeed:284
msgid "Start an app, or open a file with it"
msgstr "Lancer une application, ou ouvrir un fichier avec"

#: src/rdfeed:285
msgid "Remove a workspace and its apps"
msgstr "Supprimer un espace de travail et ses applications"

#: src/rdfeed:286
msgid "Show this help"
msgstr "Afficher cette aide"

#: src/rdfeed:287
msgid "Show the version"
msgstr "Afficher la version"

#: src/rdfeed:289
msgid "Without a command an interactive menu is shown."
msgstr "Sans commande, un menu interactif s'affiche."

#: src/rdfeed:313
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Commande inconnue : %s"

#: src/lib/common.sh:174 src/lib/menu.sh:251
msgid "never"
msgstr "jamais"

#: src/lib/common.sh:184
msgid "just now"
msgstr "à l'instant"

#: src/lib/common.sh:186
msgid "1 minute ago"
msgstr "il y a 1 minute"

#: src/lib/common.sh:189
#, sh-printf-format
msgid "%d minutes ago"
msgstr "il y a %d minutes"

#: src/lib/common.sh:191
msgid "1 hour ago"
msgstr "il y a 1 heure"

#: src/lib/common.sh:194
#, sh-printf-format
msgid "%d hours ago"
msgstr "il y a %d heures"

#: src/lib/common.sh:196
msgid "1 day ago"
msgstr "il y a 1 jour"

#: src/lib/common.sh:199
#, sh-printf-format
msgid "%d days ago"
msgstr "il y a %d jours"

#: src/lib/launch.sh:169
msgid ""
"Your password has expired. Change it on Windows or on the RD Web page, then "
"sign in again in rdfeed."
msgstr ""
"Votre mot de passe a expiré. Changez-le sous Windows ou sur la page RD Web, "
"puis reconnectez-vous dans rdfeed."

#: src/lib/launch.sh:171
msgid "Your account is locked. Ask your IT department."
msgstr ""
"Votre compte est verrouillé. Adressez-vous à votre service informatique."

#: src/lib/launch.sh:173
msgid "The server did not accept the password. Sign in again in rdfeed."
msgstr ""
"Le serveur n'a pas accepté le mot de passe. Reconnectez-vous dans rdfeed."

#: src/lib/launch.sh:175
msgid "Could not reach the server. Check the internet connection."
msgstr "Impossible de joindre le serveur. Vérifiez la connexion internet."

#: src/lib/launch.sh:178
#, sh-printf-format
msgid "FreeRDP stopped: %s"
msgstr "FreeRDP s'est arrêté : %s"

#: src/lib/launch.sh:205 src/lib/launch.sh:206
#, sh-printf-format
msgid "File not found: %s"
msgstr "Fichier introuvable : %s"

#: src/lib/launch.sh:212 src/lib/launch.sh:213
msgid ""
"FreeRDP 3 is missing. Install it to start the apps (the package is called "
"freerdp)."
msgstr ""
"FreeRDP 3 est absent. Installez-le pour lancer les applications (le paquet "
"s'appelle freerdp)."

#: src/lib/launch.sh:277
#, sh-printf-format
msgid "Opening %s in %s"
msgstr "Ouverture de %s dans %s"

#: src/lib/launch.sh:278
#, sh-printf-format
msgid "If it does not open by itself, open it in the app from the drive %s."
msgstr ""
"S'il ne s'ouvre pas tout seul, ouvrez-le dans l'application depuis le "
"lecteur %s."

#: src/lib/launch.sh:280
#, sh-printf-format
msgid "Starting %s"
msgstr "Lancement de %s"

#: src/lib/launch.sh:281
msgid ""
"If your company uses MFA, confirm the sign-in in your authenticator app."
msgstr ""
"Si votre entreprise utilise la MFA, confirmez la connexion dans votre "
"application d'authentification."

#: src/lib/launch.sh:290
msgid "A second sign-in is coming"
msgstr "Une deuxième connexion arrive"

#: src/lib/launch.sh:291
#, sh-printf-format
msgid ""
"Confirm the second prompt in your authenticator app too. It comes in about "
"%d seconds."
msgstr ""
"Confirmez aussi la deuxième demande dans votre application "
"d'authentification. Elle arrive dans environ %d secondes."

#: src/lib/launch.sh:301
#, sh-printf-format
msgid "%s could not start"
msgstr "%s n'a pas pu démarrer"

#: src/lib/launch.sh:303
#, sh-printf-format
msgid "Log: %s"
msgstr "Journal : %s"

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:93
msgid "[y/N]"
msgstr "[o/N]"

#: src/lib/menu.sh:163
msgid "1 app"
msgstr "1 application"

#: src/lib/menu.sh:165
#, sh-printf-format
msgid "%d apps"
msgstr "%d applications"

#: src/lib/menu.sh:190
msgid "No workspace yet. Add the one of your company with [1]."
msgstr ""
"Aucun espace de travail pour l'instant. Ajoutez celui de votre entreprise "
"avec [1]."

#: src/lib/menu.sh:233
msgid "off"
msgstr "désactivé"

#: src/lib/menu.sh:234
msgid "home folder"
msgstr "dossier personnel"

#: src/lib/menu.sh:237
msgid "Documents"
msgstr "Documents"

#: src/lib/menu.sh:238
msgid "Downloads"
msgstr "Téléchargements"

#: src/lib/menu.sh:243
msgid "not found"
msgstr "introuvable"

#: src/lib/menu.sh:246
#, sh-printf-format
msgid "automatic (%d %%)"
msgstr "automatique (%d %%)"

#: src/lib/menu.sh:248
msgid "classic"
msgstr "classique"

#: src/lib/menu.sh:249
msgid "GFX"
msgstr "GFX"

#: src/lib/menu.sh:250
msgid "always"
msgstr "toujours"

#: src/lib/menu.sh:252
msgid "automatic"
msgstr "automatique"

#: src/lib/menu.sh:261
msgid ""
"The apps only see the files on the server. Pick a folder to open and save "
"files of this computer in them."
msgstr ""
"Les applications ne voient que les fichiers du serveur. Choisissez un "
"dossier pour qu'elles puissent ouvrir et enregistrer des fichiers de cet "
"ordinateur."

#: src/lib/menu.sh:262
msgid ""
"The apps can open and save files in this folder. It shows up as a drive in "
"them."
msgstr ""
"Les applications peuvent ouvrir et enregistrer des fichiers dans ce dossier. "
"Il y apparaît comme un lecteur."

#: src/lib/menu.sh:263
msgid ""
"Offers the apps under \"Open with\" for their file types, for example Word "
"for .docx. The folder of the file is shared with the app while it is open."
msgstr ""
"Propose les applications dans « Ouvrir avec » pour leurs types de fichiers, "
"par exemple Word pour .docx. Le dossier du fichier est partagé tant qu'il "
"est ouvert."

#: src/lib/menu.sh:264
msgid ""
"How big the apps are drawn. Automatic follows the scale of your desktop, so "
"they are sharp and the right size."
msgstr ""
"La taille à laquelle les applications sont dessinées. Automatique suit "
"l'échelle de votre bureau : elles sont nettes et à la bonne taille."

#: src/lib/menu.sh:265
msgid "Plays the sound of the apps here, for calls and videos."
msgstr "Joue ici le son des applications, pour les appels et les vidéos."

#: src/lib/menu.sh:266
msgid ""
"Paints every window right. But some servers end the session right after "
"signing in, then go back to GFX."
msgstr "Dessine correctement chaque fenêtre. Mais certains serveurs ferment la session juste après la connexion : revenez alors à GFX."

#: src/lib/menu.sh:267
msgid ""
"Works with every server. FreeRDP may not repaint a window after it was "
"minimized or resized."
msgstr "Fonctionne avec tous les serveurs. FreeRDP peut ne pas redessiner une fenêtre réduite ou redimensionnée."

#: src/lib/menu.sh:268
msgid ""
"Always waits before the second sign-in. For when the second prompt does not "
"come with automatic."
msgstr ""
"Attend toujours avant la deuxième connexion. Si la deuxième demande n'arrive "
"pas en automatique."

#: src/lib/menu.sh:269
msgid "Never waits. Right when your company has no MFA."
msgstr ""
"N'attend jamais. Le bon choix si votre entreprise n'utilise pas la MFA."

#: src/lib/menu.sh:270
msgid ""
"Many servers with MFA need a second sign-in, and its prompt only comes after "
"a short wait. Automatic waits when the first sign-in took a while."
msgstr ""
"Beaucoup de serveurs avec MFA demandent une deuxième connexion, dont la "
"demande n'arrive qu'après une courte attente. Automatique attend si la "
"première a pris du temps."

#: src/lib/menu.sh:273
msgid ""
"Loads the list of apps again once a day, so new apps show up by themselves."
msgstr ""
"Recharge la liste des applications une fois par jour : les nouvelles "
"apparaissent d'elles-mêmes."

#: src/lib/menu.sh:275 src/lib/menu.sh:330
msgid "Needs a systemd user session."
msgstr "Nécessite une session utilisateur systemd."

#: src/lib/menu.sh:322 src/lib/menu.sh:325
msgid "Could not save the setting."
msgstr "Impossible d'enregistrer le réglage."

#: src/lib/menu.sh:371 src/lib/menu.sh:609
msgid "Settings"
msgstr "Réglages"

#: src/lib/menu.sh:372
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ choisir   ←→ ou Espace : changer   q : retour"

#: src/lib/menu.sh:373
msgid "ON"
msgstr "ACTIVÉ"

#: src/lib/menu.sh:374
msgid "OFF"
msgstr "DÉSACTIVÉ"

#: src/lib/menu.sh:456 src/lib/menu.sh:608
msgid "Workspaces"
msgstr "Espaces de travail"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:458
msgid ""
"↑↓ select   r: refresh   s: sign in again   d: remove   a: add   q: back"
msgstr ""
"↑↓ choisir   r : actualiser   s : se reconnecter   d : supprimer   a : "
"ajouter   q : retour"

#: src/lib/menu.sh:459
msgid "No workspace yet. Press a to add one."
msgstr ""
"Aucun espace de travail pour l'instant. Appuyez sur a pour en ajouter un."

#: src/lib/menu.sh:484
#, sh-printf-format
msgid "refreshed %s"
msgstr "actualisé %s"

#: src/lib/menu.sh:512
#, sh-printf-format
msgid "Remove \"%s\" and its apps?"
msgstr "Supprimer « %s » et ses applications ?"

#: src/lib/menu.sh:536 src/lib/menu.sh:607
msgid "Start an app"
msgstr "Lancer une application"

#: src/lib/menu.sh:537
msgid "↑↓ select   Enter: start   q: back"
msgstr "↑↓ choisir   Entrée : lancer   q : retour"

#: src/lib/menu.sh:538
msgid "No apps yet. Add a workspace first."
msgstr "Pas encore d'applications. Ajoutez d'abord un espace de travail."

#: src/lib/menu.sh:579
#, sh-printf-format
msgid "%s is starting. It opens in a window of its own."
msgstr "%s démarre. L'application s'ouvre dans sa propre fenêtre."

#: src/lib/menu.sh:606
msgid "Add a workspace"
msgstr "Ajouter un espace de travail"

#: src/lib/menu.sh:610
msgid "Quit"
msgstr "Quitter"

#: src/lib/workspace.sh:163
msgid "The server did not accept the user name or password."
msgstr "Le serveur n'a pas accepté le nom d'utilisateur ou le mot de passe."

#: src/lib/workspace.sh:164
#, sh-printf-format
msgid "Could not reach the server: %s"
msgstr "Impossible de joindre le serveur : %s"

#: src/lib/workspace.sh:165
#, sh-printf-format
msgid "There is no RD Web feed at %s."
msgstr "Il n'y a pas de flux RD Web à l'adresse %s."

#: src/lib/workspace.sh:166
#, sh-printf-format
msgid "Could not load the apps: %s"
msgstr "Impossible de charger les applications : %s"

#: src/lib/workspace.sh:282
#, sh-printf-format
msgid "Remote desktop of %s"
msgstr "Bureau à distance de %s"

#: src/lib/workspace.sh:284
#, sh-printf-format
msgid "%s from %s"
msgstr "%s de %s"

#: src/lib/menu.sh
msgid "Apps"
msgstr "Applications"

#: src/lib/menu.sh
msgid "Share a folder"
msgstr "Partager un dossier"

#: src/lib/menu.sh
msgid "Open files with the apps"
msgstr "Ouvrir des fichiers avec les applications"

#: src/lib/menu.sh
msgid "Size"
msgstr "Taille"

#: src/lib/menu.sh
msgid "Sound"
msgstr "Son"

#: src/lib/menu.sh
msgid "Graphics"
msgstr "Graphismes"

#: src/lib/menu.sh
msgid "Signing in"
msgstr "Connexion"

#: src/lib/menu.sh
msgid "Wait for the second MFA prompt"
msgstr "Attendre la deuxième demande MFA"

#: src/lib/menu.sh
msgid "Refresh the apps every day"
msgstr "Actualiser les applications chaque jour"
